                  <characteristics>
                    <characteristic name="Special Rules" typeId="9d2e-d14d-dd58-a829">All enemies within 12&quot; of the bearer of the Pipes of Piebald are subject to Stupidity.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Skalm" id="9ae9-1589-24de-ab9c" collective="false" hidden="false" import="true" sortIndex="24" type="upgrade">
