                  <characteristics>
                    <characteristic name="Strength" typeId="b80e-7dac-0dea-9add">+1</characteristic>
                    <characteristic name="Initiative" typeId="7849-175d-a3fa-2fff"/>
                    <characteristic name="Attacks" typeId="ffc4-c065-ab29-fb8c"/>
                    <characteristic name="Special Rules" typeId="de63-d6da-efa8-00ac">All attacks made with this weapon are resolved with Multiple Wounds (2). Against all models from Warhammer: Dwarfs, all hits have the Armour Piercing (1) special rule and the wielder may re-roll all failed rolls To Wound.</characteristic>
                  </characteristics>
