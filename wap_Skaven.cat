                              <profiles>
                                <profile name="Warpfire Braziers" id="6469-32d8-113f-1c5d" hidden="false" typeId="6f70-cea1-702c-43bc" typeName="Melee Weapon">
                                  <characteristics>
                                    <characteristic name="Strength" typeId="b80e-7dac-0dea-9add">+1</characteristic>
                                    <characteristic name="Initiative" typeId="7849-175d-a3fa-2fff"/>
                                    <characteristic name="Attacks" typeId="ffc4-c065-ab29-fb8c"/>
                                    <characteristic name="Special Rules" typeId="de63-d6da-efa8-00ac">Flaming Attacks. Magical Attacks. Multiple Wounds (D3).</characteristic>
                                  </characteristics>
                                </profile>
                              </profiles>
                              <rules>
                                <rule name="Warpfire Braziers" id="ce59-f416-3178-2edf" hidden="false">
                                  <description>At the beginning of any Close Combat phase all models in base contact (friend or foe) with Boneripper Mk II must pass a Toughness test or suffer a single wound with the Ignores Armour Saves and Magical Attacks special rules. All Clan Pestilens models gain a +1 bonus for these tests. Because Boneripper Mk II has four Warpfire Braziers, he may re-roll all failed rolls To Wound with them.</description>
                                </rule>
                              </rules>
                            </selectionEntry>
                          </selectionEntries>
                        </entryLink>
                      </entryLinks>
