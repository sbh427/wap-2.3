                    <characteristic name="Type" typeId="13f9-a26b-05af-3459">Infantry (Special Character, Skaven)</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Attack-attack!" id="21ab-1588-4120-0fe4" hidden="false">
                  <description>Any unit joined by Spinetail may re-roll To Wounds of 1 in close combat.</description>
                </rule>
                <rule name="Spined Tail" id="68c3-4bfe-1524-0b37" hidden="false">
                  <description>If Clawlord Spinetail is in base contact with an enemy Infantry Character at the start of any close combat phase, both you and your opponent roll a D6. If you roll the higher result, the enemy Character suffers one Wound which Ignores Armour Saves. If your result is at least double your opponent’s, that model suffers D3 Wounds which Ignores Armour Saves instead.</description>
                </rule>
              </rules>
            </selectionEntry>
