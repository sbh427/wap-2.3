      <infoGroups>
        <infoGroup name="Poisoned Wind Mortar Misfire Table" id="302f-7017-b4db-3d7f" hidden="false">
          <profiles>
            <profile name="1-2 Foomph" id="ce8d-5ed4-73f0-da1c" hidden="false" typeId="c972-d0be-bd2e-332b" typeName="Misfire Chart">
              <characteristics>
                <characteristic name="Result" typeId="008a-8bda-9586-4ae1">Place the large round template over the Poisoned Wind Mortar. Any model touched by the template suffers a Hit from the Poisoned Wind Mortar. After this, the Poisoned Wind Mortar is removed from play as a casualty</characteristic>
              </characteristics>
            </profile>
            <profile name="3-4 Clogged" id="9dbb-a4cb-2d1e-3a82" hidden="false" typeId="c972-d0be-bd2e-332b" typeName="Misfire Chart">
              <characteristics>
                <characteristic name="Result" typeId="008a-8bda-9586-4ae1">No firing may take place this turn.</characteristic>
              </characteristics>
            </profile>
            <profile name="5-6 Wildly off Target:" id="ba94-bcdc-1bd8-9a4d" hidden="false" typeId="c972-d0be-bd2e-332b" typeName="Misfire Chart">
              <characteristics>
                <characteristic name="Result" typeId="008a-8bda-9586-4ae1">The template scatters 3D6&quot; from its original position. Resolve any hits as normal.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
      </infoGroups>
      <infoLinks>
        <infoLink name="Weapon Team" id="ceda-0f8b-7c10-58eb" hidden="false" targetId="9a1c-90ac-a3ff-5ba0" type="profile"/>
