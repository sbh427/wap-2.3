      <profiles>
        <profile name="Poisoned Wind Mortar" id="fb41-22e1-85b1-9cb2" hidden="false" typeId="781d-35fe-dd22-05d6" typeName="War Machine">
          <characteristics>
            <characteristic name="Type" typeId="6081-ebe8-e15b-4e82">Mortar</characteristic>
            <characteristic name="Range" typeId="1c88-efb0-083f-b945">12-36&quot;</characteristic>
            <characteristic name="Strength" typeId="6ca0-d074-628f-e276"/>
            <characteristic name="Special Rules" typeId="d3a4-721b-f750-5564">Magical Attacks. Ignores Armour saves. Move or Fire. Cumbersome.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Poisoned Wind Mortar" id="e2ce-31d7-3d8f-e7f9" hidden="false">
          <description>Models hit by a Poisoned Wind Mortar must pass a T test or suffer a Wound. Note that Poisoned Wind Mortar crew wear Gas Masks. In case a Misfire is rolled, roll a D6 and consult the Poisoned Wind Mortar Misfire chart.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Doom-flayer" id="134e-a9c1-d9be-9f00" hidden="false" import="true" sortIndex="34" type="model">
