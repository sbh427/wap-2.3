              <profiles>
                <profile name="Skalm" id="ba9b-0698-804e-eff2" hidden="false" typeId="ff67-d27f-2eef-bb35" typeName="Enchanted Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="9d2e-d14d-dd58-a829">One use only. Skalm can be used at the beginning of any phase in either player’s turn. The bearer recovers all Wounds suffered up to that point in the battle.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
