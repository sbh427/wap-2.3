              <profiles>
                <profile name="Warpscroll" id="e7ca-c3e4-69b6-17cb" hidden="false" typeId="24d7-7f7d-a4d7-c26c" typeName="Arcane Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="3df8-4ab0-c4bd-e2ad">Charm. One use only. Bound spell (Level 3, cast on 9+).</characteristic>
                  </characteristics>
                </profile>
                <profile name="Warpscroll" id="59fd-776e-4f98-840e" hidden="false" typeId="cb92-d882-5ba8-11ab" typeName="Spell">
                  <characteristics>
                    <characteristic name="Spell Level" typeId="576b-eaa1-0bd1-3f7a">Bound Spell, Level 3</characteristic>
                    <characteristic name="Type" typeId="21e9-4aa2-f538-c93b">Direct Damage</characteristic>
                    <characteristic name="Casting Value" typeId="d6bf-647e-ba69-e8a0">9+</characteristic>
                    <characteristic name="Range" typeId="2954-76ea-decb-30ff">24&quot;</characteristic>
                    <characteristic name="Details" typeId="f5f2-ac1b-25cd-89c6">Inflicts a S 3 Hit on all models in the unit. If the unit suffers any casualties from the spell, they must also take a Panic test.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Scrying Stone" id="8ab9-9afb-0f7f-fab3" collective="false" hidden="false" import="true" sortIndex="1" type="upgrade">
              <constraints>
                <constraint id="aa00-e612-31f5-0ece" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Magical Ward" id="d7d2-1806-b959-d7f8" hidden="false" targetId="0ea4-277a-19d5-3635" type="profile">
                  <modifiers>
                    <modifier field="name" type="set" value="Scrying Stone"/>
                    <modifier field="bdf9-d73e-e13b-b0ce" type="set" value="2+ against the first wound."/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <profiles>
                <profile name="Scrying Stone" id="7993-1658-81c2-6650" hidden="false" typeId="24d7-7f7d-a4d7-c26c" typeName="Arcane Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="3df8-4ab0-c4bd-e2ad">Charm. One use only. The bearer of the Scrying Stone gains a Magical Ward (2+) against their first Wounding Hit suffered. However, if this Wound is saved the model gains the Stupidity special rule for the remainder of the game.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Warpstorm Scroll" id="b4f3-4855-e2da-f927" collective="false" hidden="false" import="true" sortIndex="5" type="upgrade">
              <constraints>
                <constraint id="01b4-fcb0-b8e6-ec39" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                <constraint id="3627-c486-bff5-8082" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
              </constraints>
              <costs>
