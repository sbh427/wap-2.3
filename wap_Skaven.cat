          <modifiers>
            <modifier arg="*" field="name" type="replace" value="D3"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <profiles>
        <profile name="Doom-flayer" id="cf09-75fc-d1da-2bfa" hidden="false" typeId="d9ed-a507-0102-d498" typeName="Model">
          <characteristics>
            <characteristic name="M" typeId="09ad-18df-607b-1215">6</characteristic>
