                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Master Controller" id="6bc0-a8b9-482c-5251" hidden="false">
                  <description>Throt has the Inspiring Presence (6) special rule for all Clan Moulder units.</description>
                </rule>
                <rule name="Ravening Hunger" id="aebc-7758-50df-cedf" hidden="false">
                  <description>At the start of each of his turns, Throt must pass a T test or start to eat one friendly model in base contact of your choosing. This model suffers 1 Wound with no saves allowed. If this is not possible, Throt will suffer 1 Wound with no saves allowed.</description>
                </rule>
                <rule name="Extra Arm" id="9cec-b6f7-9a97-987e" hidden="false">
                  <description>As Throt has three arms, he may use both his magic weapons at the same time.</description>
                </rule>
              </rules>
            </selectionEntry>
