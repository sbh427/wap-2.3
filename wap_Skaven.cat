          <selectionEntries>
            <selectionEntry name="Skavenbrew" id="bfe3-75a1-0993-b22f" collective="false" hidden="false" import="true" sortIndex="25" type="upgrade">
              <constraints>
                <constraint id="74d7-f908-c354-230a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                <constraint id="4856-5d0f-a06d-dd12" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="30"/>
              </costs>
              <infoGroups>
                <infoGroup name="Skavenbrew Table" id="6794-633d-b608-200c" hidden="false">
                  <profiles>
                    <profile name="1 Gone Bad" id="ac3f-976a-7aa3-d81c" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
                      <characteristics>
                        <characteristic name="Result" typeId="686b-22d8-d67f-02eb">The unit takes D6 Strength 3 automatic hits with the Ignores Armour save special rule. The Skavenbrew has no additional effect.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="2-3 Inspired Hatred" id="fa0f-ca44-c18f-17ec" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
                      <characteristics>
                        <characteristic name="Result" typeId="686b-22d8-d67f-02eb">The unit gains the Hatred special rule.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="4-5 Frenzied" id="8550-d12d-2e1a-d929" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
                      <characteristics>
                        <characteristic name="Result" typeId="686b-22d8-d67f-02eb">The unit gains the Frenzy special rule.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="6 Rabid" id="28f5-cb3f-4989-6f32" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
                      <characteristics>
                        <characteristic name="Result" typeId="686b-22d8-d67f-02eb">The unit gains the Frenzy and Hatred special rules. At the start of each of your subsequent turns, the unit suffers D6 automatic Wounds.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </infoGroup>
              </infoGroups>
              <profiles>
                <profile name="Skavenbrew" id="b689-5159-fd5f-28dd" hidden="false" typeId="ff67-d27f-2eef-bb35" typeName="Enchanted Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="9d2e-d14d-dd58-a829">One use only. This item can be used at the start of the game. Skavenbrew affects all rank-and-file models in the unit. Roll a D6 and consult the Skavenbrew Table.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
