      </entryLinks>
      <infoGroups>
        <infoGroup name="Berserk Abomination Chart" id="0ef2-11bd-9f3d-c23d" hidden="false">
          <profiles>
            <profile name="1 Grinding Halt" id="9a5c-a2d6-7e3e-8cb7" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
              <characteristics>
                <characteristic name="Result" typeId="686b-22d8-d67f-02eb">The beast does not move this turn.</characteristic>
              </characteristics>
            </profile>
            <profile name="2-5 Blind Fury" id="32bc-3960-2b73-f2fd" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
              <characteristics>
                <characteristic name="Result" typeId="686b-22d8-d67f-02eb">The model moves the distance rolled in a random direction determined by a scatter dice.</characteristic>
              </characteristics>
            </profile>
            <profile name="6 Fluid Injected!" id="e380-1995-ba51-3e6d" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
              <characteristics>
                <characteristic name="Result" typeId="686b-22d8-d67f-02eb">The Hell Pit Abomination moves as normal, and will increase its S by +1 for the remainder of the game. Further Berserk Abomination rolls of 6 will not increase the beast’s profile, but will instead immediately inflict D6 wounds on it.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
        <infoGroup name="Too Horible do Die Chart" id="a2b3-ab98-e640-7f61" hidden="false">
          <profiles>
            <profile name="1-3 Dead" id="1024-2330-ebf6-1850" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
              <characteristics>
                <characteristic name="Result" typeId="686b-22d8-d67f-02eb">The Hell Pit Abomination is removed from play as casualty.</characteristic>
              </characteristics>
            </profile>
            <profile name="4-5 The Rats Emerge" id="905b-dd3f-696e-208e" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
              <characteristics>
                <characteristic name="Result" typeId="686b-22d8-d67f-02eb">All units in base contact with the Abomination take 2D6 Strength 2 Hits. The Hell Pit Abomination is then removed from play as a casualty.</characteristic>
              </characteristics>
            </profile>
            <profile name="6 It&apos;s Alive!" id="0d8b-dc7a-7f11-b63e" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
              <characteristics>
                <characteristic name="Result" typeId="686b-22d8-d67f-02eb">The Hell Pit Abomination remains alive with D3 Wounds left.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
        <infoGroup name="Close Combat Attack Chart" id="21f5-0a01-bb10-138b" hidden="false">
          <profiles>
            <profile name="1-2 Feed" id="3cd2-998e-c86e-8eda" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
              <characteristics>
                <characteristic name="Result" typeId="686b-22d8-d67f-02eb">All enemy models in base contact suffer an automatic Strength 6 hit with Multiple Wounds (D3).</characteristic>
              </characteristics>
            </profile>
            <profile name="3-4 Flailing Fists:" id="417b-dbe5-aee2-3833" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
              <characteristics>
                <characteristic name="Result" typeId="686b-22d8-d67f-02eb">The Hell Pit Abomination attacks using Random Attacks (2D6).</characteristic>
              </characteristics>
            </profile>
            <profile name="5-6 Avalanche of Flesh" id="329d-4ebe-f883-9a40" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
              <characteristics>
                <characteristic name="Result" typeId="686b-22d8-d67f-02eb">Every enemy model in base contact with the Abomination must pass an I test or suffer an automatic S 6 hit. Additionally, the Hell Pit Abomination attacks using Random Attacks (D6).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
      </infoGroups>
      <infoLinks>
        <infoLink name="Immunity (*)" id="4563-abcf-612d-3634" hidden="false" targetId="8f93-30da-a9db-adc7" type="rule">
