            <profile name="Storm Banner" id="32b7-ba87-3db6-a339" hidden="false" typeId="fc80-e52f-edf4-4e7e" typeName="Magic Standard">
              <characteristics>
                <characteristic name="Special Rules" typeId="97aa-092b-c6fe-4f5a">Bound spell (Level 2, cast on 7+). This item contains the Howling Warpgale spell from the Lore of Ruin.</characteristic>
              </characteristics>
            </profile>
