      </costs>
      <infoGroups>
        <infoGroup name="Doom-flayer Misfire Chart" id="c8b7-ae68-28f8-9322" hidden="false">
          <profiles>
            <profile name="1-2 BaBlam!" id="c30e-5603-4c5f-d163" hidden="false" typeId="c972-d0be-bd2e-332b" typeName="Misfire Chart">
              <characteristics>
                <characteristic name="Result" typeId="008a-8bda-9586-4ae1">Place the large round template over the Doom-flayer. Any model touched by the template suffers a Strength 4 Hit with the Armour Piercing (1) special rule. After this, the Doom-flayer is removed from play as a casualty.</characteristic>
              </characteristics>
            </profile>
            <profile name="3-5 ZZZZzap!" id="1431-649f-49b7-681c" hidden="false" typeId="c972-d0be-bd2e-332b" typeName="Misfire Chart">
              <characteristics>
                <characteristic name="Result" typeId="008a-8bda-9586-4ae1">The Doom-flayer and all models in base contact take a S 4 Hit with Lightning Attacks.</characteristic>
              </characteristics>
            </profile>
            <profile name="6 Power Failure" id="1694-20f0-8ca6-21cb" hidden="false" typeId="c972-d0be-bd2e-332b" typeName="Misfire Chart">
              <characteristics>
                <characteristic name="Result" typeId="008a-8bda-9586-4ae1">The Doom-flayer may not attack or use The Best Defence save this turn.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
      </infoGroups>
      <infoLinks>
        <infoLink name="Scurry Away!" id="0f15-4821-0fdd-dfad" hidden="false" targetId="45db-9bbc-8b3b-4865" type="rule"/>
