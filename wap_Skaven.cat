          <profiles>
            <profile name="1-2 Crunch!: " id="Plague Furnace Mishap Chart" hidden="false" typeId="9881-2753-3a1a-d2ad" typeName="Mishap Chart">
              <characteristics>
                <characteristic name="Result" typeId="d9c7-3474-73f2-8aa4">The Plague Furnace immediately suffers D3 wounds and the unit pushing it takes D6 at S 5 hits.</characteristic>
              </characteristics>
            </profile>
            <profile name="3-5 Bilious Cloud:" id="065c-7f53-528b-6812" hidden="false" typeId="9881-2753-3a1a-d2ad" typeName="Mishap Chart">
              <characteristics>
                <characteristic name="Result" typeId="d9c7-3474-73f2-8aa4">Immediately work out a special Enshrouded by Fog attack that causes 2D6 hits on the unit pushing the Plague Furnace only.</characteristic>
              </characteristics>
            </profile>
            <profile name="6 Maddening Fumes!:" id="c366-a294-dc49-eaa2" hidden="false" typeId="9881-2753-3a1a-d2ad" typeName="Mishap Chart">
              <characteristics>
                <characteristic name="Result" typeId="d9c7-3474-73f2-8aa4">The unit pushing the Plague Furnace makes an additional full round of close combat attacks against any foe in base contact. After this, they suffer D6 Wounds. Any casualties caused count towards combat resolution.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
