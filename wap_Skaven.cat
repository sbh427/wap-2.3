              <rules>
                <rule name="Trophy Heads" id="9ebd-ba74-70ee-3e6f" hidden="false">
                  <description>Queek must issue or accept a challenge if possible. When fighting in a challenge, Queek adds +1 to both his To Hit and To Wound dice rolls.</description>
                </rule>
                <rule name="The Red Guard" id="b1d6-7abf-6dcc-f5b7" hidden="false">
                  <description>Queek must be accompanied by a unit of Stormvermin chosen from the army list at a cost of +2 points per model. This unit has +1 Strength. Queek may never choose to leave this unit. No Grey Seers may join the unit.</description>
                </rule>
              </rules>
