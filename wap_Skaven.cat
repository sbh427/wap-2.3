              <rules>
                <rule name="A Reputation for Cunning" id="ff6d-0b71-15a5-f1dc" hidden="false">
                  <description>Roll a D3 before starting deployment, the result is the number of friendly Skaven Infantry units that may deploy using the Vanguard special rule.</description>
                </rule>
                <rule name="Foster Competition" id="12f1-5fd3-86e4-09fb" hidden="false">
                  <description>All friendly Stormvermin units within 12&quot; of Krittok may re-roll 1&apos;s To Hit in close combat.</description>
                </rule>
              </rules>
