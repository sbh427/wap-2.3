                      <profiles>
                        <profile name="The Cloak of Shadows" id="6d56-3641-eb14-cfb1" hidden="false" typeId="065f-58ea-de5d-d3c6" typeName="Talisman">
                          <characteristics>
                            <characteristic name="Special Rules" typeId="08ca-4a32-203d-40c0">Enemy units cannot charge or target Snikch with missile attacks or spells if they are more than 12&quot; away from him. Within 12&quot;, he can only be charged or targeted by first rolling a 4+. If the test is failed, the unit may choose a new target as normal. This item has no effect as long as Snikch is Hidden.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
