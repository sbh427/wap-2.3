            <selectionEntry name="Doomrocket" id="adb2-c374-f8ec-937b" collective="false" hidden="false" import="true" sortIndex="20" type="upgrade">
              <constraints>
                <constraint id="aba6-b8f4-511d-e964" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="8de7-36e8-d13c-5441" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="30"/>
              </costs>
              <infoGroups>
                <infoGroup name="Doomrocket Misfire Chart" id="1b9f-a323-878b-07bc" hidden="false">
                  <profiles>
                    <profile name="1 Thoooooom!" id="b003-d7fa-31eb-b018" hidden="false" typeId="c972-d0be-bd2e-332b" typeName="Misfire Chart">
                      <characteristics>
                        <characteristic name="Result" typeId="008a-8bda-9586-4ae1">Place the template over the model that fired the rocket and resolve the blast as normal.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="2-5 Stabilising Fin Lost" id="6a55-8f20-011c-b20a" hidden="false" typeId="c972-d0be-bd2e-332b" typeName="Misfire Chart">
                      <characteristics>
                        <characteristic name="Result" typeId="008a-8bda-9586-4ae1">The template scatters 3D6&quot; from its original position. Resolve any hits as normal.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="6 It&apos;s a Dud" id="480d-7a1d-4a21-a3b8" hidden="false" typeId="c972-d0be-bd2e-332b" typeName="Misfire Chart">
                      <characteristics>
                        <characteristic name="Result" typeId="008a-8bda-9586-4ae1">Resolve the shot as normal, but do not place the template. Any model directly below the impact spot suffers a single S 5 hit.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </infoGroup>
              </infoGroups>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="c7a7-6f89-fd46-9eac" field="selections" includeChildForces="false" includeChildSelections="true" scope="ancestor" shared="true" type="notInstanceOf" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Doomrocket" id="25a2-d286-763d-4f6b" hidden="false" typeId="5ac6-af7f-fe0f-57cd" typeName="Ranged Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="af3c-d805-702c-9af9">12-36&quot;</characteristic>
                    <characteristic name="Strength" typeId="29fe-29a3-f94f-2e90">5</characteristic>
                    <characteristic name="Multiple Shots" typeId="b886-975e-beb1-f6ca"/>
                    <characteristic name="Special Rules" typeId="96b8-546e-ac33-6054">Clan Skryre only. One use only. Cumbersome. In case a Misfire is rolled, roll a D6 and consult the Doomrocket Misfire chart.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
