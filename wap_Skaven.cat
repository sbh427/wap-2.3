  <rules>
    <rule name="Clan Enmity" id="19a5-0fee-5f4b-f3ac" hidden="false">
      <description>Units belonging to each of the Greater Clans (Pestilens, Eshin, Moulder, Skryre) may only be joined by characters from the same Clan. Characters from one of these Clans may not join a unit containing models from another Clan.</description>
    </rule>
  </rules>
