                    <characteristic name="Special Rules" typeId="3df8-4ab0-c4bd-e2ad">The Eye of the Horned Rat may be used at the beginning of your Magic Phase. Roll a D6, on a 2+, add one dice to your power dice pool. On 1, remove one dice from your power dice pool.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
