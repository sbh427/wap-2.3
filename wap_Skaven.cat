                    <characteristic name="Special Rules" typeId="d3a4-721b-f750-5564">Armour Piercing (1). Multiple Shots (3D6). Magical Attacks. Rapid Fire</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Ratling Cannons" id="6973-2a23-620f-c590" hidden="false">
                  <description>Each To Hit roll result of 1 inflicts one hit on the closest friendly unit in the firing unit&apos;s front arc that is within range. If there are no eligible friendly units, then the attack misses.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Windlaunchers" id="f75b-1689-9664-4ad0" collective="false" hidden="false" import="true" sortIndex="5" type="upgrade">
