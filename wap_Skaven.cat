              </profiles>
              <rules>
                <rule name="Prophet of the Horned Rat" id="8c17-7b9f-16b6-7d5c" hidden="false">
                  <description>Vizzik Skour may re-roll one failed casting attempt each Magic phase.</description>
                </rule>
                <rule name="The Death Frenzy" id="ceb7-ece3-cecc-cf4e" hidden="false">
                  <description>All friendly units within 12&quot; of Vizzik Skour gain the Frenzy special rule. In addition, all enemy units within 12&quot; of Vizzik Skour suffer -1 Leadership.</description>
                </rule>
                <rule name="Fissures in Reality" id="1f75-d195-9387-5294" hidden="false">
                  <description>All enemy units in base contact in Vizzik Skour at the start of the close combat phase suffer D6 Hits that Wound on a 4+ with no saves allowed.</description>
                </rule>
                <rule name="Gaze of the Gnaw" id="015d-9ee2-86ab-b303" hidden="false">
                  <description>All enemy units in base contact in Vizzik Skour&apos;s front arc suffer -1 To Hit.</description>
                </rule>
              </rules>
