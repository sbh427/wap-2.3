                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Da Howlerz" id="e15a-1217-2750-4819" hidden="false">
                  <description>Gitilla must be accompanied by a unit of Goblin Wolf Riders chosen from the army list at a cost of 10 points per model. This unit has +1 Ballistic Skill and the Quick Shot special rule. Gitilla may never choose to leave this unit.</description>
                </rule>
                <rule name="Ulda the Great Wolf" id="106b-6cb1-f85a-4fad" hidden="false">
                  <description>Gitilla, and any unit he is with, can choose to re-roll any Pursuit or Flee rolls they make.</description>
                </rule>
              </rules>
