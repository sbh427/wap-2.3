                            <characteristic name="Special Rules" typeId="9d2e-d14d-dd58-a829">Bound spell (power level 5). The Baleful Mask contains the Gaze of Mork spell from Spells of da Big Waaagh!</characteristic>
                          </characteristics>
                        </profile>
