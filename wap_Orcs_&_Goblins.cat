        <infoLink name="Immunity (*)" id="3276-47cf-9b74-d9a2" hidden="false" targetId="8f93-30da-a9db-adc7" type="rule">
          <modifiers>
            <modifier arg="*" field="name" type="replace" value="Psychology"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <profiles>
        <profile name="Colossal Squig" id="3637-1179-0b78-c8cc" hidden="false" typeId="d9ed-a507-0102-d498" typeName="Model">
          <characteristics>
            <characteristic name="M" typeId="09ad-18df-607b-1215">*</characteristic>
            <characteristic name="WS" typeId="f049-8a65-9c04-1559">4</characteristic>
            <characteristic name="BS" typeId="7b67-9dfa-eeac-d007"/>
            <characteristic name="S" typeId="edd2-7979-54a4-6b35">7</characteristic>
            <characteristic name="T" typeId="df90-5cbd-8cf9-95b2">5</characteristic>
            <characteristic name="W" typeId="27ee-0675-122f-a1b1">6</characteristic>
            <characteristic name="I" typeId="7cca-e51f-edc2-7322">3</characteristic>
            <characteristic name="A" typeId="bfa2-d38d-7c93-d3f0">6</characteristic>
            <characteristic name="Ld" typeId="a199-f10b-a038-5730">3</characteristic>
            <characteristic name="Type" typeId="13f9-a26b-05af-3459">Monster (Fungoid)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Dinner&apos;s Dinner!" id="e058-10f2-7b04-c8b1" hidden="false">
          <description>If the Colossal Squig&apos;s Random Movement special rule brings it into contact with any friendly unit, it automatically inflicts D6 Hits at its base Strength. After this, move the Colossal Squig 1&quot; back from the unit.</description>
        </rule>
        <rule name="Falls Apart" id="33e0-e424-653b-f170" hidden="false">
          <description>When a Colossal Squig is removed as a casualty, every model in base contact with it suffers an automatic S 3 hit.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Rogue Idol of Gork" id="032a-e2da-27f3-ef26" collective="false" hidden="false" import="true" sortIndex="49" type="model">
      <categoryLinks>
        <categoryLink name="Rare" id="07d7-ca6e-6f48-1ef2" hidden="false" primary="true" targetId="0eb4-f376-7725-b05b"/>
        <categoryLink name="Monster" id="3c5e-b4bb-82f2-1385" hidden="false" primary="false" targetId="e1a0-da31-05c5-9a15"/>
      </categoryLinks>
