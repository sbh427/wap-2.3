                        <profile name="Skarsnik&apos;s Prodder" id="7661-7b28-1d80-b3a5" hidden="false" typeId="cb92-d882-5ba8-11ab" typeName="Spell">
                          <characteristics>
                            <characteristic name="Spell Level" typeId="576b-eaa1-0bd1-3f7a">Bound Spell</characteristic>
                            <characteristic name="Type" typeId="21e9-4aa2-f538-c93b">Magic Missile</characteristic>
                            <characteristic name="Casting Value" typeId="d6bf-647e-ba69-e8a0">5+</characteristic>
                            <characteristic name="Range" typeId="2954-76ea-decb-30ff">24&quot;</characteristic>
                            <characteristic name="Details" typeId="f5f2-ac1b-25cd-89c6">Causes D3 S 6 hits which Ignores Armour saves. The number of hits is increased to D6 if Skarsnik is within a Night Goblin unit with at least 5 models.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
