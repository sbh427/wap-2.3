              <profiles>
                <profile name="Big Stabba" id="0655-ff5f-3013-2211" hidden="false" typeId="6f70-cea1-702c-43bc" typeName="Melee Weapon">
                  <characteristics>
                    <characteristic name="Strength" typeId="b80e-7dac-0dea-9add"/>
