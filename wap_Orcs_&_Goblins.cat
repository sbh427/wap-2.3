                  <profiles>
                    <profile name="1 Glyph of Shyish" id="33bb-3574-dfbc-940e" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
                      <characteristics>
                        <characteristic name="Result" typeId="686b-22d8-d67f-02eb">Trugg suffers 1 Wound with no saves allowed.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="2 Glyph of Aqshy" id="8fdb-3d88-4a96-3e7a" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
                      <characteristics>
                        <characteristic name="Result" typeId="686b-22d8-d67f-02eb">Trugg gains the Flaming Attacks and Multiple Wounds (D3) special rules until the start of your next turn.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="3 Glyph of Ghur" id="1ce8-4359-3253-745c" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
                      <characteristics>
                        <characteristic name="Result" typeId="686b-22d8-d67f-02eb">Trugg gains +1 Attack until the start of your next turn.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="4 Glyph of Hysh" id="6875-b898-ff53-ada8" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
                      <characteristics>
                        <characteristic name="Result" typeId="686b-22d8-d67f-02eb">Trugg gains +1 Leadership until the start of your next turn.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="5 Glyph of Ulgu" id="c5af-dd6d-c7bb-5e9b" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
                      <characteristics>
                        <characteristic name="Result" typeId="686b-22d8-d67f-02eb">Enemy shooting and close combat attacks suffer -1 To Hit Trugg until the start of your next turn.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="6 Glyph of Chamon" id="a417-fc6f-dfc0-8557" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
                      <characteristics>
                        <characteristic name="Result" typeId="686b-22d8-d67f-02eb">Trugg gains a 3+ armour save until the start of your next turn.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </infoGroup>
