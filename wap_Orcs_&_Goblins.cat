                  <description>The Pump Wagon&apos;s Random Movement is increased by D6.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Giant Explodin&apos; Spores" id="d8d0-e0b9-4427-bb5c" collective="true" hidden="false" import="true" sortIndex="4" type="upgrade">
              <constraints>
