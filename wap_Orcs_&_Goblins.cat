                        <profile name="Wizzbang the Power Squig" id="66c1-38db-1197-4b22" hidden="false" typeId="24d7-7f7d-a4d7-c26c" typeName="Arcane Item">
                          <characteristics>
                            <characteristic name="Special Rules" typeId="3df8-4ab0-c4bd-e2ad">At the end of either player&apos;s Magic phase, you can store one unused dice from your pool in the Power Squig. At the start of the next Magic phase, you must add this extra dice to your power or dispel pool as appropriate.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
