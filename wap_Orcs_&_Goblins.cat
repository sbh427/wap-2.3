              </costs>
              <profiles>
                <profile name="Skull Wand of Kaloth" id="7a09-9eae-6072-5c63" hidden="false" typeId="24d7-7f7d-a4d7-c26c" typeName="Arcane Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="3df8-4ab0-c4bd-e2ad">The Skull Wand unleashes a curse on a single enemy model that is in base contact with the bearer at the start of the Close Combat phase. The victim must pass a Leadership test (using its own, unmodified, Ld) or be slain instantly, with no save of any kind allowed. In addition, the bearer of the Skull Wand causes Terror.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
