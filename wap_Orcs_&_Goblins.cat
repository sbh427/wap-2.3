          <profiles>
            <profile name="Crimson Deffcap" id="aa30-bed7-d207-49f5" hidden="false" typeId="5ef4-e835-4a5d-0201" typeName="Shrooms">
              <characteristics>
                <characteristic name="Effect" typeId="1257-673a-728c-2a3b">All Squigs in the unit may roll an extra D6 for their Random Movement and discard the lowest result.</characteristic>
              </characteristics>
            </profile>
            <profile name="Sproutin&apos; Moon" id="8fcf-c99b-3a39-fffe" hidden="false" typeId="5ef4-e835-4a5d-0201" typeName="Shrooms">
              <characteristics>
                <characteristic name="Effect" typeId="1257-673a-728c-2a3b">All Squigs in the unit gain +1 Attack.</characteristic>
              </characteristics>
            </profile>
            <profile name="Yellow Lurka" id="be7a-295d-fd6b-d1e3" hidden="false" typeId="5ef4-e835-4a5d-0201" typeName="Shrooms">
              <characteristics>
                <characteristic name="Effect" typeId="1257-673a-728c-2a3b">All Squigs in the unit gain the Multiple Wounds (2) special rule.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
      </infoGroups>
