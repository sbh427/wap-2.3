        <profile name="Mangler Squigs" id="d629-ba3f-cf46-aec2" hidden="false" typeId="d9ed-a507-0102-d498" typeName="Model">
          <characteristics>
            <characteristic name="M" typeId="09ad-18df-607b-1215">*</characteristic>
            <characteristic name="WS" typeId="f049-8a65-9c04-1559"/>
            <characteristic name="BS" typeId="7b67-9dfa-eeac-d007"/>
            <characteristic name="S" typeId="edd2-7979-54a4-6b35">6</characteristic>
            <characteristic name="T" typeId="df90-5cbd-8cf9-95b2">4</characteristic>
            <characteristic name="W" typeId="27ee-0675-122f-a1b1">6</characteristic>
            <characteristic name="I" typeId="7cca-e51f-edc2-7322">3</characteristic>
            <characteristic name="A" typeId="bfa2-d38d-7c93-d3f0">*</characteristic>
            <characteristic name="Ld" typeId="a199-f10b-a038-5730">3</characteristic>
            <characteristic name="Type" typeId="13f9-a26b-05af-3459">Monstrous Beast (Fungoid)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Watch Out!" id="e990-064a-bf35-ae81" hidden="false">
          <description>Mangler Squigs treats all terrain that is not open ground as Dangerous Terrain. If their move would take them into contact with Impassable Terrain or off a table edge then they must take a Dangerous Terrain test and will stop 1&quot; short of the obstruction.</description>
        </rule>
        <rule name="Ker-splat!" id="fe15-f21d-51d4-9b9a" hidden="false">
          <description>If Mangler Squigs comes into contact with another unit during its move, it inflicts 2D6 Strength 6 Hits. If this destroys the unit, the Mangler Squigs continues their move. Otherwise, the Mangler Squigs are removed as a casualty after resolving the damage.</description>
        </rule>
        <rule name="Gone Crazy!" id="2b0c-d905-931c-b90b" hidden="false">
          <description>Mangler Squigs that make a Ker-Splat! attack and are not removed as a result Go Crazy. Once Mangler Squigs have Gone Crazy they will move in a random direction when they move in the Compulsory Moves sub-phase.</description>
        </rule>
        <rule name="Completely Out of Control" id="f063-d34f-e1b1-4d1b" hidden="false">
          <description>Mangler Squigs are removed as a casualty when:
• They contact other Mangler Squigs (both Mangler Squigs are removed as casualties).
• They have Gone Crazy and rolled a triple for movement.
• Any unit moves into contact with the Mangler Squigs. That unit suffers 2D6 Strength 6 Hits before the Mangler Squigs are removed.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Squig Gobba" id="afcf-b7ea-04ba-d8dc" collective="false" hidden="false" import="true" sortIndex="44" type="unit">
      <categoryLinks>
        <categoryLink name="Rare" id="5d42-67b4-f7ca-6103" hidden="false" primary="true" targetId="0eb4-f376-7725-b05b"/>
