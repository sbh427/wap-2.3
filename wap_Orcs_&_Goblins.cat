        <categoryLink name="Night Goblin" id="9d8c-dc47-49f2-ebcf" hidden="false" primary="false" targetId="4b36-7dac-325f-8159"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="75"/>
      </costs>
      <infoGroups>
        <infoGroup name="Squig Gobba Table" id="9295-7eb1-5749-0367" hidden="false">
          <profiles>
            <profile name="3-4 Acid Guts" id="2df2-2bf5-d88b-42cc" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
              <characteristics>
                <characteristic name="Result" typeId="686b-22d8-d67f-02eb">Every model within 6&quot; of the Squig Gobba (including the Night Goblin Tenders) takes a Strength 2 Hit which Ignores Armour saves.</characteristic>
              </characteristics>
            </profile>
            <profile name="5-6 Stomach Rumblings" id="04c0-d4a7-ea2a-41ca" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
              <characteristics>
                <characteristic name="Result" typeId="686b-22d8-d67f-02eb">Nothing happens this turn, but you must instead roll 4D6 when firing the Squig Gobba next shooting phase.</characteristic>
              </characteristics>
            </profile>
            <profile name="7-17 Squig Torrent" id="c93e-8d8d-c106-20a1" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
              <characteristics>
                <characteristic name="Result" typeId="686b-22d8-d67f-02eb">This is resolved as a shot from a Stone Thrower that uses the large template with a range of 36&quot;. Any model covered by the template suffers a S 4 hit. If a misfire is rolled, the Squig Gobba suffers D3 Wounds and the shot is wasted.</characteristic>
              </characteristics>
            </profile>
            <profile name="18+ Intestinal Explosion" id="1964-c7ed-f2b5-9ca9" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
              <characteristics>
                <characteristic name="Result" typeId="686b-22d8-d67f-02eb">The Squig Gobba immediately makes a Breath Weapon Attack at S 6. After the attack has been resolved, the Squig Gobba suffers D3 Wounds.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
      </infoGroups>
      <infoLinks>
        <infoLink name="Mixed Unit" id="1fdd-a953-923c-38f6" hidden="false" targetId="e00a-3a09-9b67-e994" type="rule"/>
        <infoLink name="Immunity (*)" id="dabd-9d86-6b35-95d2" hidden="false" targetId="8f93-30da-a9db-adc7" type="rule">
          <modifiers>
            <modifier arg="*" field="name" type="replace" value="Psychology"/>
          </modifiers>
        </infoLink>
