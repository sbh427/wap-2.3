            <characteristic name="Type" typeId="13f9-a26b-05af-3459">Monstrous Beast (Fungoid)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Tied Down" id="2728-7fe0-ce26-158f" hidden="false">
          <description>The Squig Gobba cannot move after it has been deployed except pivoting on the spot. It may not pursue an enemy it defeats in combat. If the Squig Gobba breaks from combat, it is automatically destroyed.</description>
        </rule>
        <rule name="Squig Gobba" id="a51f-c0e7-1981-1b11" hidden="false">
          <description>The Squig Gobba may fire in the Shooting Phase as long as at least one Tender remains and it is not in close combat. When firing the Squig Gobba, roll 3D6 and consult the Squig Gobba Table.</description>
        </rule>
      </rules>
