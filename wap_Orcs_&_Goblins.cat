                  <characteristics>
                    <characteristic name="Strength" typeId="b80e-7dac-0dea-9add">+D6*</characteristic>
                    <characteristic name="Initiative" typeId="7849-175d-a3fa-2fff"/>
                    <characteristic name="Attacks" typeId="ffc4-c065-ab29-fb8c">+D6*</characteristic>
                    <characteristic name="Special Rules" typeId="de63-d6da-efa8-00ac">*Roll a D6 at the start of each round of combat – the wielder of this weapon adds that number to both his Attacks and Strength in that round.
However, the bearer&apos;s Weapon Skill is lowered by an amount equal to half the dice roll (i.e. 1-2 = -1 Weapon Skill, 3-4 = -2 Weapon Skill, and 5-6 = -3 Weapon Skill).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
