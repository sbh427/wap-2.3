              <rules>
                <rule name="Da Great Leader" id="4c94-9a27-9f5f-377a" hidden="false">
                  <description>Friendly units within 18&quot; of Gorbad that fail an Animosity test add his current number of Wounds to their roll on the Animosity table.</description>
                </rule>
                <rule name="Da Boss &apos;as a Plan!" id="f829-ee48-cab4-cb0a" hidden="false">
                  <description>Gorbad must be the Army General and also counts as the Battle Standard Bearer. In addition, he has the Inspiring Presence (6) and Hold Your Ground (6) special rules.</description>
                </rule>
                <rule name="Orcs are da Best" id="a1e9-33f3-00a5-e71e" hidden="false">
                  <description>An Orc &amp; Goblin army that includes Gorbad may upgrade any number of Common Orcs Boys and Common Orc Boar Boys to Big &apos;Uns without them counting as Special Units.</description>
                </rule>
              </rules>
