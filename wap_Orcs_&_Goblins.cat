              <profiles>
                <profile name="Grom the Paunch" id="4ea5-237d-49ec-7907" hidden="false" typeId="d9ed-a507-0102-d498" typeName="Model">
                  <characteristics>
                    <characteristic name="M" typeId="09ad-18df-607b-1215">4</characteristic>
                    <characteristic name="WS" typeId="f049-8a65-9c04-1559">5</characteristic>
                    <characteristic name="BS" typeId="7b67-9dfa-eeac-d007">3</characteristic>
                    <characteristic name="S" typeId="edd2-7979-54a4-6b35">4</characteristic>
                    <characteristic name="T" typeId="df90-5cbd-8cf9-95b2">4</characteristic>
                    <characteristic name="W" typeId="27ee-0675-122f-a1b1">3</characteristic>
                    <characteristic name="I" typeId="7cca-e51f-edc2-7322">4</characteristic>
                    <characteristic name="A" typeId="bfa2-d38d-7c93-d3f0">4</characteristic>
                    <characteristic name="Ld" typeId="a199-f10b-a038-5730">8</characteristic>
                    <characteristic name="Type" typeId="13f9-a26b-05af-3459">(Special Character; Goblin, Warboss)</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Grom&apos;s Goblin Guard" id="e97e-05e2-b6c2-d8df" hidden="false">
                  <description>Grom may include a unit of Common Goblin Gitz chosen from the army list at a cost of +2 points per model. This unit has +1 Weapon Skill and wears medium armour.</description>
                </rule>
                <rule name="Eats Elves for Breakfast" id="2ec9-763a-e297-2328" hidden="false">
                  <description>As long as Grom is alive, all units in his army ignore the Fear Elves special rule.</description>
                </rule>
                <rule name="Goblin General" id="5064-686a-115b-19e3" hidden="false">
                  <description>If your army includes Grom, he must be the Army General. In addition, you may not include any Orc Lords if Grom is your General. An army containing Grom must include at least one unit of Goblin Gitz.</description>
                </rule>
                <rule name="Grom&apos;s Waaagh!" id="ea3c-b4f4-02f3-f10b" hidden="false">
                  <description>Grom has the Waaagh! special rule. When Grom calls a Waaagh!, in addition to the units that would normally be affected, every unit of five or more Goblins in the army adds +1 to its combat resolution for the rest of the player turn.</description>
                </rule>
              </rules>
            </selectionEntry>
