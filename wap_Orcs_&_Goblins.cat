          <characteristics>
            <characteristic name="M" typeId="09ad-18df-607b-1215">4</characteristic>
            <characteristic name="WS" typeId="f049-8a65-9c04-1559">3</characteristic>
            <characteristic name="BS" typeId="7b67-9dfa-eeac-d007">3</characteristic>
