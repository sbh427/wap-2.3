            <characteristic name="T" typeId="df90-5cbd-8cf9-95b2">4</characteristic>
            <characteristic name="W" typeId="27ee-0675-122f-a1b1">2</characteristic>
            <characteristic name="I" typeId="7cca-e51f-edc2-7322">3</characteristic>
            <characteristic name="A" typeId="bfa2-d38d-7c93-d3f0">2</characteristic>
            <characteristic name="Ld" typeId="a199-f10b-a038-5730">6</characteristic>
            <characteristic name="Type" typeId="13f9-a26b-05af-3459">Infantry (Character, Goblin)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Squigboss" id="eb34-128f-6512-806b" hidden="false">
          <description>Models with this special rule may join units of Squig Herds, following the rules for Handlers from the Mixed Unit special rule.</description>
        </rule>
        <rule name="Gnasha-Squig" id="e3c6-4d69-3610-2d2d" hidden="false">
          <description>Squigbosses and Gnasha-Squigs follow the split profile rules for Cavalry.</description>
        </rule>
        <rule name="Mycophile&apos;s Pouch" id="bbb6-dfcb-3878-3a30" hidden="false">
          <description>At the start of each of your turns, the Squigboss can bestow one of the shrooms to any unit of Squigs they are with. Each shrooms effect lasts until the start of your next turn. A unit can only be under the effect of one shroom type at a time.</description>
        </rule>
      </rules>
