              <profiles>
                <profile name="Trugg the Troll King" id="4b7a-406a-915b-6d53" hidden="false" typeId="d9ed-a507-0102-d498" typeName="Model">
                  <characteristics>
                    <characteristic name="M" typeId="09ad-18df-607b-1215">6</characteristic>
                    <characteristic name="WS" typeId="f049-8a65-9c04-1559">5</characteristic>
                    <characteristic name="BS" typeId="7b67-9dfa-eeac-d007">1</characteristic>
                    <characteristic name="S" typeId="edd2-7979-54a4-6b35">7</characteristic>
                    <characteristic name="T" typeId="df90-5cbd-8cf9-95b2">6</characteristic>
                    <characteristic name="W" typeId="27ee-0675-122f-a1b1">6</characteristic>
                    <characteristic name="I" typeId="7cca-e51f-edc2-7322">1</characteristic>
                    <characteristic name="A" typeId="bfa2-d38d-7c93-d3f0">6</characteristic>
                    <characteristic name="Ld" typeId="a199-f10b-a038-5730">7</characteristic>
                    <characteristic name="Type" typeId="13f9-a26b-05af-3459">Monster (Special Character, Troll)</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Massive Troll Vomit" id="d24e-bff6-9d7d-e684" hidden="false">
                  <description>In addition to his normal Attacks, Trugg inflicts D6 automatic Strength 6 hits which Ignores Armour Saves.</description>
                </rule>
                <rule name="Imbued with Life" id="0bf5-8f26-8cb8-bc5b" hidden="false">
                  <description>Trugg may re-roll failed Regeneration rolls.</description>
                </rule>
                <rule name="Crushing Grip" id="1a97-5874-b33b-3835" hidden="false">
                  <description>In addition to his normal attacks, Trugg may do a special attack against any single model in base contact with a Unit Strength of 2 or less. That model immediately suffers D3 Wounds which Ignores Armour Saves.</description>
                </rule>
                <rule name="Troll King" id="a861-8fa8-e6c6-4f6a" hidden="false">
                  <description>You may take units of Trolls as Core Units instead of Special Units in an army containing Trugg the Troll King. In addition, all friendly Trolls treat him as the Army General instead of whoever the actual Army General is.</description>
                </rule>
              </rules>
            </selectionEntry>
