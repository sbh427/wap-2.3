              <rules>
                <rule name="Da Troll Calla" id="f6d4-937d-1f41-96d2" hidden="false">
                  <description>All friendly Trolls treat Ogdruz as the Army General.</description>
                </rule>
                <rule name="Protect Da Boss" id="560b-f0c9-46bd-b61c" hidden="false">
                  <description>Ogdruz may join and use &quot;Look Out, Sir!&quot; from friendly units of Trolls, even though they are not the same Troop Type.</description>
                </rule>
                <rule name="Syphoned Strength" id="6a24-ae08-9451-f535" hidden="false">
                  <description>Whilst Ogdruz Swampdigga is within 6&quot; of a friendly unit of Trolls with 3 or more models, he gains a +1 to casting bonus.</description>
                </rule>
              </rules>
