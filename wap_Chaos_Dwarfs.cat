                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Slave Tyrant" id="85aa-ff67-05b0-d95d" hidden="false">
                  <description>Friendly units of Hobgoblins within 12&quot; of Zhatan ignore the Treacherous Gits special rule. In addition, Zhatan causes Terror in all enemy units of Orcs, Goblins, Hobgoblins and Gnoblars.</description>
                </rule>
                <rule name="The Blazing Beards of Bazherak" id="ef6b-7a7c-f23d-810c" hidden="false">
                  <description>If Zhatan the Black is included in your army, you may upgrade one unit of Warriors to The Blazing Beards of Bazherak for a cost of +1.5 points per model. This unit has the Flaming Attacks and Frenzy special rules.</description>
                </rule>
                <rule name="Boundless Cruelty" id="43e3-2efa-f029-fb59" hidden="false">
                  <description>All enemy units within 6&quot; of Zhatan suffer -1 to their Leadership. This has no effect on models with Immunity (Psychology).</description>
                </rule>
                <rule name="Infernal Cohort" id="30c9-a706-ecc5-a689" hidden="false">
                  <description>You may upgrade one unit of Warriors with heavy armour for +1.5 points/model for each model with this special rule in your army.</description>
                </rule>
              </rules>
