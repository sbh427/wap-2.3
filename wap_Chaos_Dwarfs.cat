                <profile name="Chalice of Blood and Darkness" id="8c4e-715d-f505-4065" hidden="false" typeId="24d7-7f7d-a4d7-c26c" typeName="Arcane Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="3df8-4ab0-c4bd-e2ad">In the beginning of any Magic phase the bearer may reduce the number of dice held in both sides dice pools by D3 each. Roll these dice separately, declaring before rolling which dice applies to which side. If one or more natural 1&apos;s are rolled then the bearer suffers a Wound which Ignores Armour saves. If one or more natural 6&apos;s are rolled the bearer may recover a Wound previously lost in the game.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
