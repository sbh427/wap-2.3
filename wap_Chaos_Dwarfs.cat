              <profiles>
                <profile name="Black Gem of Gnar" id="0934-87b1-f595-f52b" hidden="false" typeId="ff67-d27f-2eef-bb35" typeName="Enchanted Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="9d2e-d14d-dd58-a829">One use only. This item can be activated at the beginning of either player&apos;s Close Combat phase, after challenges are issued and accepted. The bearer and one model in base contact (bearer’s choice) may not attack or be attacked for the duration of that phase. Work out combat resolution as normal.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
