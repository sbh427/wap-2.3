          <selectionEntries>
            <selectionEntry name="Whirlwind" id="e792-b1f0-2350-e4dc" hidden="false" import="true" type="upgrade">
              <rules>
                <rule name="Whirlwind" id="f1fa-6277-6c50-43c1" hidden="false">
                  <description>In addition to its normal Impact Hits, the Whirlwind causes D6 Impact Hits at Strength 5 at the start of each round of close combat. Note that this only applies when fighting to the Whirlwind&apos;s front. The Bull Centaur may only attack when fighting to the Whirlwind&apos;s flank or rear.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Tenderizer" id="08c6-b2dd-1e1a-8712" hidden="false" import="true" type="upgrade">
              <rules>
                <rule name="Tenderizer" id="f46d-999a-2974-b097" hidden="false">
                  <description>In addition to its normal Impact Hits, the Tenderizer causes D3 Impact Hits at Strength 6 with the Multiple Wounds (D3) special rule at the start of each round of close combat. Note that this only applies when fighting to the Tenderizer&apos;s front. The Bull Centaur may only attack when fighting to the Tenderizer&apos;s flank or rear.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </entryLink>
      </entryLinks>
