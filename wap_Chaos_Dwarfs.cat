              <rules>
                <rule name="Hashut&apos;s Dark Ravagers" id="dfaa-011b-8473-bc8c" hidden="false">
                  <description>If Shar&apos;tor the Executioner is included in your army, you may upgrade one unit of Bull Centaur Renders to Hashut&apos;s Dark Ravagers for a cost of +5 points per model. This unit has the Devastating Charge special rule. It must be equipped with additional hand weapons and also carries throwing axes.</description>
                </rule>
                <rule name="Lord of the Ba&apos;hal" id="07bb-82ef-dc55-c944" hidden="false">
                  <description>All Bull Centaur units within 12&quot; of Shar&apos;tor may re-roll failed charge rolls.</description>
                </rule>
              </rules>
