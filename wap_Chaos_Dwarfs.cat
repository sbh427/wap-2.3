            <characteristic name="Type" typeId="13f9-a26b-05af-3459">Chariot</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Unstoppable" id="64d5-db76-64cf-b872" hidden="false">
          <description>Iron Daemons ignore terrain classified as Obstacles and ignores damage from Dangerous Terrain, except Rivers and Marshland, which are treated as Impassable terrain.</description>
        </rule>
        <rule name="Grind Attack" id="aec6-3bfd-eb74-a515" hidden="false">
          <description>The Iron Daemon has the Stomp (D6) special rule like a Monster, but only against units to its front. </description>
        </rule>
        <rule name="Lumbering" id="9ffb-3939-94b6-de36" hidden="false">
          <description> If a double 1 is rolled for its charge distance, the Iron Daemon does not move at all this turn. Iron Daemons cannot overrun or pursue in combat if they destroy or rout their foes. </description>
        </rule>
      </rules>
