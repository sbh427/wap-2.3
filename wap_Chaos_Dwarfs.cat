                  <modifiers>
                    <modifier field="annotation" type="set" value="Steam Cannonade"/>
                    <modifier field="d3a4-721b-f750-5564" type="set" value="Cumbersome, Multiple Shots (Artillery Dice + 2D6), Rapid Fire.
If a Destroyed! result is rolled on the Blackpowder Misfire chart, the Steam Cannonade is destroyed and may not be used again. In addition, the Iron Daemon it is mounted on suffers D6 wounds with no saves allowed. "/>
                  </modifiers>
                </infoLink>
                <infoLink name="Blackpowder Misfire Chart" id="0676-3bea-ef35-1170" hidden="false" targetId="bb8f-7181-30f9-fc65" type="infoGroup"/>
              </infoLinks>
            </selectionEntry>
            <selectionEntry name="Skullcracker" id="95fc-8f14-44a9-d981" hidden="false" import="true" sortIndex="3" type="upgrade">
              <costs>
                <cost name="pts" typeId="points" value="30"/>
              </costs>
              <infoLinks>
                <infoLink name="Impact Hits (*)" id="83d3-d0ec-45ba-16a0" hidden="false" targetId="2214-09a9-225d-a274" type="rule">
                  <modifiers>
                    <modifier arg="*" field="name" type="replace" value="2D6"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <rules>
                <rule name="Skullcracker" id="8f69-d193-6225-6cdf" hidden="false">
                  <description>The Iron Daemon gains the Impact Hits (2D6) special rule and its Grind Attack inflicts 2D6 hits instead of D6. In addition, its Stomp works against all models regardless of their Line of Sight value.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </entryLink>
