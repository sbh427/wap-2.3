            <infoLink name="2-3 Flail and Crush" id="5b01-af45-3a4d-37e5" hidden="false" targetId="94b6-04a8-b19f-0fdd" type="profile"/>
            <infoLink name="4-6 Ripping Blades" id="d196-38ea-ecb3-ee37" hidden="false" targetId="5fa7-330b-0a90-d48a" type="profile"/>
            <infoLink name="1 Legbreaker" id="69fd-b00c-58c6-fc32" hidden="false" targetId="acb6-1b11-91c3-5690" type="profile"/>
            <infoLink name="2-4 Smash and Pick" id="ec41-8588-f058-979a" hidden="false" targetId="0b78-6872-fbd4-8389" type="profile"/>
            <infoLink name="5-6 &apos;Eadbutt" id="2de2-83a1-712a-f316" hidden="false" targetId="2280-3f4d-29a9-545c" type="profile"/>
          </infoLinks>
          <rules>
            <rule name="Siege Giant Special Attacks" id="db55-fb09-b707-525b" hidden="false">
              <description>Giants do not attack in the same way as other creatures. They are far too large and fractious to take orders and much too scatter-brained to have any sort of coherent plan. To determine what happens in each Close Combat phase, pick a unit in base contact with the Giant and roll a D6 on either the Man-Sized Things Chart or the Big Things Chart. Use the Man-Sized Things Chart when fighting Infantry, Cavalry, War Beasts or Swarms. Use the Big Things Chart when fighting Monsters, Monstrous Beasts, Monstrous Infantry, Monstrous Cavalry, Monstrous Creatures, Chariots, War Machines, and Shrines. If no suitable target is in base contact, roll again on the chart until you get another result.</description>
            </rule>
          </rules>
        </infoGroup>
      </infoGroups>
      <infoLinks>
        <infoLink name="Fall Over" id="59eb-9ea0-1d5d-2a43" hidden="false" targetId="4a8b-1056-0bcd-e293" type="rule"/>
        <infoLink name="Immunity (*)" id="4e90-94b2-851e-4591" hidden="false" targetId="8f93-30da-a9db-adc7" type="rule">
          <modifiers>
            <modifier arg="*" field="name" type="replace" value="Psychology"/>
          </modifiers>
        </infoLink>
        <infoLink name="Stubborn" id="2ccb-9735-0380-a45b" hidden="false" targetId="d56e-8ec7-dbcd-aeee" type="rule"/>
        <infoLink name="Natural Armour" id="612f-b1e8-37bb-e066" hidden="false" targetId="9aa1-cdbd-98da-c7d1" type="profile">
          <modifiers>
            <modifier field="168d-1cc2-66f3-e766" type="set" value="6+"/>
            <modifier field="97ea-ecf7-8d24-b2ca" type="set" value="6+"/>
            <modifier field="annotation" type="set" value="Siege Giant"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <profiles>
        <profile name="Siege Giant" id="e74e-8bc7-5b4d-63d3" hidden="false" typeId="d9ed-a507-0102-d498" typeName="Model">
          <characteristics>
            <characteristic name="M" typeId="09ad-18df-607b-1215">6</characteristic>
            <characteristic name="WS" typeId="f049-8a65-9c04-1559">3</characteristic>
