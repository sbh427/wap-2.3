              <profiles>
                <profile name="Amulet of the Serpent" id="56e2-f6ca-2508-7ae3" hidden="false" typeId="ff67-d27f-2eef-bb35" typeName="Enchanted Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="9d2e-d14d-dd58-a829">The bearer of the Amulet of the Serpent and any unit they join gain the Poisoned Attacks special rule in close combat.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Cloak of the Dunes" id="8ebe-ce97-57b3-b8c3" hidden="false" import="true" sortIndex="7" type="upgrade">
              <constraints>
                <constraint id="2c8a-eace-11e7-bfc6" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
                <constraint id="9b34-668a-6daa-24bf" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="0"/>
                <constraint id="e79a-faa7-64cc-da75" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
