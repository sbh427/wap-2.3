                  <characteristics>
                    <characteristic name="Special Rules" typeId="9d2e-d14d-dd58-a829">All friendly units within 6&quot; may make March moves despite being Undead</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Scarab Brooch" id="616a-577e-872d-da83" hidden="false" import="true" sortIndex="5" type="upgrade">
