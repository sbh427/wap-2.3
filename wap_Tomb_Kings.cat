                </rule>
                <rule name="Chariot of the Gods" id="f494-8792-6850-0e46" hidden="false">
                  <description>Impact Hits from the Chariot of the Gods have the Flaming Attacks and Magical Attacks special rules.</description>
                </rule>
                <rule name="The Curse of Settra" id="3858-f59c-864f-d747" hidden="false">
                  <description>In addition to the normal Curse of the Necropolis, if Settra is killed by any means, then every enemy unit within 2D6&quot; suffers 2D6 Strength 2 hits.</description>
                </rule>
              </rules>
