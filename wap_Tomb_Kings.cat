              <profiles>
                <profile name="Scarab Brooch" id="95e2-03fa-972c-53e2" hidden="false" typeId="ff67-d27f-2eef-bb35" typeName="Enchanted Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="9d2e-d14d-dd58-a829">All models using the Entombed Beneath the Sands special rule may re-roll failed rolls to enter the battlefield and can re-roll the scatter and/or artillery dice when emerging if their marker is within 12&quot; of the bearer of this item.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Amulet of the Serpent" id="49a0-5e10-0da5-d220" hidden="false" import="true" sortIndex="6" type="upgrade">
              <constraints>
                <constraint id="6317-1aee-3cd2-ce80" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="8632-123a-b782-e464" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
