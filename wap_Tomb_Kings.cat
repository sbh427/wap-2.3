              <profiles>
                <profile name="Cloak of the Dunes" id="40db-cc08-706f-a20b" hidden="false" typeId="ff67-d27f-2eef-bb35" typeName="Enchanted Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="9d2e-d14d-dd58-a829">The wearer of the Cloak of Dunes has the Fly (10) special rule. In addition, if the bearer moves over an unengaged enemy unit in the Remaining Moves sub-phase, that enemy unit immediately suffers 2D6 Strength 2 hits, resolved as a missile attacks against the rear. The bearer can move over several enemy units in the same turn if you wish, causing damage to every unit. The same target unit cannot be affected more than once in the same turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Golden Death Mask of Kharnutt" id="874d-50f5-6918-529d" hidden="false" import="true" sortIndex="8" type="upgrade">
              <constraints>
                <constraint id="b8ac-bf1b-4778-7f5f" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="0f65-6dfc-7cb9-613d" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="40"/>
              </costs>
              <profiles>
                <profile name="Golden Death Mask of Kharnutt" id="60a9-b3d4-2722-76c6" hidden="false" typeId="ff67-d27f-2eef-bb35" typeName="Enchanted Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="9d2e-d14d-dd58-a829">The model wearing this mask causes Terror. In addition, enemy units within 6&quot; of the wearer cannot benefit from the Inspiring Presence or Hold Your Ground special rules.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
