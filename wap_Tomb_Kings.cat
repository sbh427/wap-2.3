                <profile name="Enkhil&apos;s Kanopi" id="0264-6365-87d1-f3f6" hidden="false" typeId="cb92-d882-5ba8-11ab" typeName="Spell">
                  <characteristics>
                    <characteristic name="Spell Level" typeId="576b-eaa1-0bd1-3f7a">Bound Spell, Level 1</characteristic>
                    <characteristic name="Type" typeId="21e9-4aa2-f538-c93b">Special aura</characteristic>
                    <characteristic name="Casting Value" typeId="d6bf-647e-ba69-e8a0">5+</characteristic>
                    <characteristic name="Range" typeId="2954-76ea-decb-30ff">24&quot;</characteristic>
                    <characteristic name="Details" typeId="f5f2-ac1b-25cd-89c6">Roll a D6 for every &apos;remains in play&apos; and active spell that lasts more than one turn within range: on a 2+ that spell is automatically dispelled. For each spell that is ended in this way, add D3 power dice to your power pool.</characteristic>
                  </characteristics>
