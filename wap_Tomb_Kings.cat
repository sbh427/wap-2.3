          <selectionEntries>
            <selectionEntry name="Neferra&apos;s Scrolls of Mighty Incantations" id="c67f-0b47-dc06-174b" hidden="false" import="true" sortIndex="4" type="upgrade">
              <constraints>
                <constraint id="de2d-5996-92d4-dcc0" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="c6ae-cbff-66c1-94e8" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="30"/>
              </costs>
              <profiles>
                <profile name="Neferra&apos;s Scrolls of Mighty Incantations" id="26f0-db43-773f-69d7" hidden="false" typeId="24d7-7f7d-a4d7-c26c" typeName="Arcane Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="3df8-4ab0-c4bd-e2ad">One use only. A Wizard can declare that he is using Neferra&apos;s Scrolls of Mighty Incantations immediately before casting a spell. If he does so, the Wizard must add a number of extra bonus dice, equal to his Wizard level, to the power dice he is going to roll (you still need to roll at least one dice from the power pool). The bonus dice do not count as power dice. However, a roll of any double (except 1&apos;s) when initially casting a spell using them will counts as rolling a 6 for the purpose of Ultimate Power.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Hieratic Jar" id="4c8c-0341-d09e-1690" hidden="false" import="true" sortIndex="3" type="upgrade">
              <constraints>
                <constraint id="b757-5935-8b19-2ad8" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <profiles>
                <profile name="Hieratic Jar" id="1b07-0864-a63d-bbc0" hidden="false" typeId="24d7-7f7d-a4d7-c26c" typeName="Arcane Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="3df8-4ab0-c4bd-e2ad">One use only. The Hieratic Jar may be used at the start of any of your Magic phases. The bearer immediately gains +D3 Power dice. Only they may use these extra Power dice.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Tablet of Tahoth" id="614a-ce40-e3b7-f620" hidden="false" import="true" sortIndex="2" type="upgrade">
              <constraints>
                <constraint id="abf6-6a90-41cf-e127" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <profiles>
                <profile name="Tablet of Tahoth" id="e83e-0129-babe-33b8" hidden="false" typeId="24d7-7f7d-a4d7-c26c" typeName="Arcane Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="3df8-4ab0-c4bd-e2ad">One use only. This item may be used after rolling the Power dice to cast a spell. When used, add a +D3 casting bonus to the roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
