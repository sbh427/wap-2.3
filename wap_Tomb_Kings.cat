                <profile name="Chariot of Fire" id="0bc5-dcbc-b0dc-dd75" hidden="false" typeId="ff67-d27f-2eef-bb35" typeName="Enchanted Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="9d2e-d14d-dd58-a829">The model&apos;s Chariot causes 2D6 Impacts Hits with the Flaming Attacks and Magical Attacks special rules.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Crown of Kings" id="996f-2cf9-77c8-0d37" hidden="false" import="true" sortIndex="4" type="upgrade">
