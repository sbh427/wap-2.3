              <characteristics>
                <characteristic name="Special Rules" typeId="97aa-092b-c6fe-4f5a">All enemy units in base contact with the unit carrying the Standard of the Cursing Word must pass a Leadership test or suffer D6 Wounds which Ignores Armour Saves at the start of each round of close combat.</characteristic>
              </characteristics>
            </profile>
