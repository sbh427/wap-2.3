    <selectionEntry name="Grudge Rune" id="267a-259a-3431-e17b" collective="true" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="a2b1-c37e-c8d2-3f3c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
      </constraints>
      <profiles>
        <profile name="Grudge Rune" id="d126-b900-e5c8-eb59" hidden="false" noindex="true" typeId="be21-8ba1-7009-d43e" typeName="Weapon Rune">
          <characteristics>
            <characteristic name="Effect" typeId="daeb-8a2c-9eae-f2dd">For each Grudge Rune in your army, nominate one enemy character or monster at the beginning of the game. The wielder of a weapon engraved with a Grudge Rune gains +1 To Hit and can re-roll failed To Wound rolls in close combat when attacking the nominated model. Multiples of this rune have no further effect.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
