              </costs>
              <profiles>
                <profile name="Runic Tablet of Thungni" id="3fad-ba6a-80bd-d80e" hidden="false" typeId="ff67-d27f-2eef-bb35" typeName="Enchanted Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="9d2e-d14d-dd58-a829">The bearer and any unit they join gain the Armour Piercing (1) special rule.</characteristic>
                  </characteristics>
