                  </characteristics>
                </profile>
                <profile name="1" id="a665-e178-3801-f735" hidden="false" typeId="0a1b-c67c-10d3-713e" typeName="Liquid Fortification">
                  <characteristics>
                    <characteristic name="Result" typeId="a586-177e-1b4d-a3b6">Bad Brew: The unit gains Flammable until the start of the next friendly turn.</characteristic>
                  </characteristics>
                </profile>
                <profile name="02-04" id="afe6-50b2-5d1a-46f4" hidden="false" typeId="0a1b-c67c-10d3-713e" typeName="Liquid Fortification">
                  <characteristics>
                    <characteristic name="Result" typeId="a586-177e-1b4d-a3b6">Belligerent: The unit gains Stubborn until the start of the next friendly turn.</characteristic>
                  </characteristics>
                </profile>
                <profile name="05-06" id="2b71-7e59-6e58-bde1" hidden="false" typeId="0a1b-c67c-10d3-713e" typeName="Liquid Fortification">
                  <characteristics>
                    <characteristic name="Result" typeId="a586-177e-1b4d-a3b6">Leathered: Each member of the unit gains +1 Toughness until the start of the next friendly turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Liquid Fortification" id="5dee-0234-0d4d-a6b5" hidden="false">
                  <description>As long as Bugman is alive, roll a D6 at the start of each friendly turn and consult the Liquid Fortification chart to see what effects his draughts have upon himself and any unit he has currently joined.</description>
                </rule>
                <rule name="Bugman&apos;s Rangers" id="d340-7a60-63f9-2060" hidden="false">
                  <description>Josef Bugman must be accompanied by a unit of Rangers chosen from the army list at a cost of 17 points per model. This unit has Strength 4 and are equipped with great weapons, crossbows, medium armour and shields. Josef Bugman may never choose to leave this unit.</description>
                </rule>
                <rule name="Stout Courage" id="b90f-a438-4177-c24e" hidden="false">
                  <description>Bugman and any unit he joins have Immunity (Fear/Terror) as long as he remains with the unit.</description>
                </rule>
              </rules>
              <selectionEntries>
