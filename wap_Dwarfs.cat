                          <characteristics>
                            <characteristic name="Effect" typeId="2019-7faf-64f7-0c61">A model with the Master Rune of Spellbinding gets +1 to all attempts to channel dispel dice.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Master Rune of Spite" id="02b4-0e28-ea86-5b16" collective="false" hidden="false" import="true" sortIndex="4" type="upgrade">
                      <constraints>
                        <constraint id="c6c3-7258-2f55-79a6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                        <constraint id="467d-a36b-520a-00bb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                      </constraints>
                      <costs>
                        <cost name="pts" typeId="points" value="30"/>
                      </costs>
                      <profiles>
                        <profile name="Master Rune of Spite" id="a7eb-c449-c041-eadb" hidden="false" typeId="46dc-ac3a-6194-9dc2" typeName="Talismanic Rune">
                          <characteristics>
                            <characteristic name="Effect" typeId="2019-7faf-64f7-0c61">Every time a model with the Master Rune of Spite is Hit in close combat, the model that struck the blow suffers a Strength 4 hit.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                  </selectionEntries>
