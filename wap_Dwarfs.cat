    <selectionEntry name="Master Rune of Kingship" id="3bb9-8c16-78bc-13e9" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="0eb7-b306-a75d-fd25" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
