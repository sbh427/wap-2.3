      <profiles>
        <profile name="Master Rune of Balance" id="f482-722c-a303-db82" hidden="false" noindex="true" typeId="46dc-ac3a-6194-9dc2" typeName="Talismanic Rune">
          <characteristics>
            <characteristic name="Effect" typeId="2019-7faf-64f7-0c61">Runesmiths/Runelords only. During the enemy&apos;s Magic phase, this rune allows the owning player to remove one power dice from his opponent&apos;s pool and add it to his own dispel pool.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Rune of Spellbreaking (x2)" id="3584-5745-45e6-c12e" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="2016-f907-bc9c-e083" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
      </constraints>
      <profiles>
        <profile name="Rune of Spellbreaking (x2)" id="6c9e-6771-a70e-1214" hidden="false" noindex="true" typeId="46dc-ac3a-6194-9dc2" typeName="Talismanic Rune">
          <characteristics>
            <characteristic name="Effect" typeId="2019-7faf-64f7-0c61">One use only. When an enemy spell has been cast, the bearer can use it instead of attempting to dispel the spell by using dispel dice. This gives them 6 free dispel dice to attempt to dispel the spell, which cannot be combined with any other dispel dice (Ultimate Power applies as normal). This may also be used to dispel spells that Remains in Play. 

After the spell is dispelled, roll a D6; on a 4+, the enemy spell is lost to the Wizard casting it and cannot be cast by him for the rest of the game.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Rune of Luck" id="311c-b9bd-7660-56d6" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="9738-b639-e044-749d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
      </constraints>
      <profiles>
        <profile name="Rune of the Luck" id="834e-4e27-de20-302a" hidden="false" typeId="46dc-ac3a-6194-9dc2" typeName="Talismanic Rune">
          <characteristics>
            <characteristic name="Effect" typeId="2019-7faf-64f7-0c61">One use only. A model with a Rune of Luck can re-roll a single To Hit roll, To Wound roll, armour save, invulnerable save or characteristic test during the game.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
