                      <profiles>
                        <profile name="Master Rune of Dragon Slaying" id="19e2-9b9b-dc08-8bf2" hidden="false" typeId="be21-8ba1-7009-d43e" typeName="Weapon Rune">
                          <characteristics>
                            <characteristic name="Effect" typeId="daeb-8a2c-9eae-f2dd">Against Dragons and Drakes, a weapon engraved with the Master Rune of Dragon Slaying will always wound on a To Wound roll of 2+ and has Multiple Wounds (2).</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Master Rune of Flight" id="17e0-0ba0-482b-c53a" collective="false" hidden="false" import="true" sortIndex="3" type="upgrade">
                      <constraints>
                        <constraint id="2ee0-cf4e-682c-d6bc" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                        <constraint id="8f6c-60e1-d783-1491" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                      </constraints>
                      <costs>
                        <cost name="pts" typeId="points" value="20"/>
                      </costs>
                      <profiles>
                        <profile name="Master Rune of Flight" id="d869-fee6-084a-07d9" hidden="false" typeId="be21-8ba1-7009-d43e" typeName="Weapon Rune">
                          <characteristics>
                            <characteristic name="Effect" typeId="daeb-8a2c-9eae-f2dd">A weapon engraved with the Master Rune of Flight can be thrown like a missile weapon with a range of up to 12&quot; which always hits on a roll of 2+. Roll To Wound as if the target had suffered a hit from the weapon in close combat.

Any additional runes on the weapon will also take effect. After this, the weapon flies back to the wielder. A weapon with the Master Rune of Flight can also be used in close combat as normal.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Master Rune of Kragg the Grim" id="bc5b-a15c-e571-5a12" collective="false" hidden="false" import="true" sortIndex="1" type="upgrade">
                      <constraints>
                        <constraint id="8192-01b6-1ef0-8189" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                        <constraint id="ed19-9e2c-4dfd-4ea7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                      </constraints>
                      <costs>
