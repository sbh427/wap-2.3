              <rules>
                <rule name="Traditional Army" id="b843-9006-86cb-2461" hidden="false">
                  <description>If Alrik is in your army, then Thunderers counts as Special Units, Firethrowers and Gyrocopters counts as Rare Units, and Irondrakes, Flame Cannons, Organ Guns, Thunderbarges and Grudgebreakers counts as 2 units for the purpose of duplicate choices that are allowed.</description>
                </rule>
                <rule name="Lord of the Hold" id="1481-2567-656e-63b4" hidden="false">
                  <description>If Alrik is included in your army, he must be your Army General.</description>
                </rule>
              </rules>
