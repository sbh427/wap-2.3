                  <profiles>
                    <profile name="Rune of Parrying" id="4435-4ad4-b8fd-729b" hidden="false" typeId="be21-8ba1-7009-d43e" typeName="Weapon Rune">
                      <characteristics>
                        <characteristic name="Effect" typeId="daeb-8a2c-9eae-f2dd">A weapon engraved with a Rune of Parrying causes all enemy models attempting to attack its wielder in close combat to suffer a -1 penalty on their To Hit rolls. Multiples of this rune have no further effect.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
