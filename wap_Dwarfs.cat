                          <characteristics>
                            <characteristic name="Effect" typeId="daeb-8a2c-9eae-f2dd">A weapon engraved with the Master Rune of Banishment may re-roll failed To Wound rolls against models with Ethereal, Undead or Vampiric.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Master Rune of Dragon Slaying" id="b0fb-8bce-c09e-50d1" collective="false" hidden="false" import="true" sortIndex="10" type="upgrade">
                      <constraints>
                        <constraint id="98ae-fd9d-4316-f9d7" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
