              </profiles>
            </selectionEntry>
            <selectionEntry name="Teardrop of Grungni" id="5780-d4ea-1db8-0740" collective="false" hidden="false" import="true" sortIndex="3" type="upgrade">
              <constraints>
                <constraint id="3b67-ea73-24b0-11ed" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                <constraint id="9125-0524-b68e-5767" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="20"/>
              </costs>
              <profiles>
                <profile name="Teardrop of Grungni" id="ad69-2f46-7b63-ad45" hidden="false" typeId="ff67-d27f-2eef-bb35" typeName="Enchanted Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="9d2e-d14d-dd58-a829">One use only. This item is a missile attack with a 6&quot; range. The target automatically suffers D3 Strength 6 Hits. In addition, if the target is a lone model, it must halve all its Movement until the start of your next turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Silver Horn of Vengeance" id="8aa4-5dc7-968b-ca2f" collective="false" hidden="false" import="true" sortIndex="6" type="upgrade">
              <constraints>
                <constraint id="8f54-4bab-ea39-92b7" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                <constraint id="720a-391f-28a3-233c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="30"/>
              </costs>
              <profiles>
                <profile name="Silver Horn of Vengeance" id="8484-84e3-3d1f-84bd" hidden="false" typeId="ff67-d27f-2eef-bb35" typeName="Enchanted Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="9d2e-d14d-dd58-a829">One use only. The Silver Horn of Vengeance can be used at the start of any friendly turn. Its wielder, and any friendly units within 6&quot;, has Devastating Charge until the start of their following turn. Additionally, once used, the blower of the Silver Horn of Vengeance, and any unit he joins, cause Fear in all Elves for the rest of the game.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Healing Salve of Valaya" id="e915-c0cb-c043-cb38" collective="false" hidden="false" import="true" sortIndex="2" type="upgrade">
              <constraints>
                <constraint id="fbcc-b90d-8fce-85df" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                <constraint id="d768-2fcc-8663-3b17" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <profiles>
                <profile name="Healing Salve of Valaya" id="78c9-8ef7-5cd7-caac" hidden="false" typeId="ff67-d27f-2eef-bb35" typeName="Enchanted Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="9d2e-d14d-dd58-a829">One use only. This item can be used at the start of the controlling player&apos;s turn. The model immediately recovers D3 Wounds up to their starting value.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Resounding Gromril Horn" id="4616-c989-87cf-81f5" collective="false" hidden="false" import="true" sortIndex="1" type="upgrade">
              <constraints>
                <constraint id="8f83-1d0e-4f64-3f1e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                <constraint id="6937-ec2d-3f60-0f35" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <profiles>
                <profile name="Resounding Gromril Horn" id="ec01-b13d-d08f-89e7" hidden="false" typeId="ff67-d27f-2eef-bb35" typeName="Enchanted Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="9d2e-d14d-dd58-a829">One use only. This item may be used at the start of any of your turns. Once used, all friendly units within 12&quot; gain +1 to their Leadership for the duration of the turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
