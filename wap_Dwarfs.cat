          </costs>
          <profiles>
            <profile name="Enchanted Rune" id="ab7b-e84b-99cf-c258" hidden="false" typeId="a099-45a8-556d-3912" typeName="Engineering Rune">
              <characteristics>
                <characteristic name="Effect" typeId="b5e6-a050-5ffa-0bb5">All shooting attacks from a war machine engraved with an Enchanted Rune have the Magical Attacks special rule.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Rune of Concussive Force" id="e3c1-15ae-ed6f-977b" collective="false" hidden="false" import="true" sortIndex="7" type="upgrade">
