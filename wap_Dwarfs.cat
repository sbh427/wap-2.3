              <profiles>
                <profile name="Golden Sceptre of Norgrim" id="e45a-346c-605d-aaf8" hidden="false" typeId="ff67-d27f-2eef-bb35" typeName="Enchanted Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="9d2e-d14d-dd58-a829">The bearer and any unit they are with may re-roll 1&apos;s To Hit and To Wound in close combat.</characteristic>
                  </characteristics>
