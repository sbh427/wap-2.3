                      <characteristics>
                        <characteristic name="Effect" typeId="51cc-aa7c-4178-d853">A standard bearing the Rune of Kadrin allow all models in the unit to re-roll all To Wound rolls of 1 with close combat and missile attacks.</characteristic>
                      </characteristics>
