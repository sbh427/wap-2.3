                  <selectionEntries>
                    <selectionEntry name="Master Rune of Challenge" id="db18-d492-833a-4583" collective="false" hidden="false" import="true" sortIndex="1" type="upgrade">
                      <constraints>
                        <constraint id="4976-029d-2a29-1aff" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                        <constraint id="21a9-71b7-0741-fe2f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                      </constraints>
                      <costs>
                        <cost name="pts" typeId="points" value="15"/>
                      </costs>
                      <profiles>
                        <profile name="Master Rune of Challenge" id="78d0-3072-2fe4-b24a" hidden="false" typeId="46dc-ac3a-6194-9dc2" typeName="Talismanic Rune">
                          <characteristics>
                            <characteristic name="Effect" typeId="2019-7faf-64f7-0c61">One use only. The rune is used during the enemy turn before they declare charges. Nominate one enemy unit within 12&quot; of the rune user. The unit must be able to charge and reach the rune user or the unit he is with according to the normal rules. The enemy unit must either declare a charge against the rune user (and any unit he is with) or must flee in the Compulsory Movement phase as if it had failed a Panic test. The rune user (and any unit he is with) can only elect to Hold or Stand and Shoot. Any Terror tests are taken as normal. This rune has no effect on units that have Immunity (Psychology).</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Master Rune of Passage" id="97d8-4e54-1ed2-7c3d" collective="false" hidden="false" import="true" sortIndex="2" type="upgrade">
                      <constraints>
                        <constraint id="be0f-54f3-5b28-4bef" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                        <constraint id="bdd5-4bb6-eaf9-05f9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                      </constraints>
                      <costs>
                        <cost name="pts" typeId="points" value="20"/>
                      </costs>
                      <profiles>
                        <profile name="Master Rune of Passage" id="7912-78b8-3a1e-0f58" hidden="false" typeId="46dc-ac3a-6194-9dc2" typeName="Talismanic Rune">
                          <characteristics>
                            <characteristic name="Effect" typeId="2019-7faf-64f7-0c61">A model with the Master Rune of Passage, and any unit he joins gains the Strider special rule.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Master Rune of Spellbinding" id="04de-533e-140b-686c" collective="false" hidden="false" import="true" sortIndex="3" type="upgrade">
                      <constraints>
                        <constraint id="088d-bd0d-7539-38d8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                        <constraint id="fb3f-766d-2099-05b4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                      </constraints>
