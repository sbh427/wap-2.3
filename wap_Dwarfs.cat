                  <characteristics>
                    <characteristic name="Effect" typeId="e733-22fc-fe56-04eb">A model with this runic tattoo gains +1 Weapon Skill.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
