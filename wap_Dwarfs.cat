          <characteristics>
            <characteristic name="Effect" typeId="d89a-1335-63eb-c328">The unit gains the Mighty Blow (1) special rule.</characteristic>
          </characteristics>
        </profile>
        <profile name="Dwarf Special Reserve" id="32b7-995b-f53e-12ff" hidden="false" typeId="40ed-61eb-17b3-aae6" typeName="Beer Casks">
          <characteristics>
            <characteristic name="Effect" typeId="d89a-1335-63eb-c328">The unit gains the Immunity (Psychology) special rule.</characteristic>
          </characteristics>
        </profile>
        <profile name="Troll Brew" id="7cb1-78fc-2858-b4f0" hidden="false" typeId="40ed-61eb-17b3-aae6" typeName="Beer Casks">
          <characteristics>
            <characteristic name="Effect" typeId="d89a-1335-63eb-c328">The unit gains the Regeneration (6+) special rule.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Beer Casks" id="04e4-18ae-5e68-44a9" hidden="false">
          <description>At the start of each of your turns, the Brewmaster can bestow one of the following beers to himself and the unit they are with. Roll a D6; on a 1, the Brewmaster and their unit suffer -1 to their Weapon Skill, Ballistic Skill and Initiative in addition to the effect of the chosen beer. Each beer effect lasts until the start of your next turn. A unit can only be under the effect of one beer type at a time.</description>
        </rule>
      </rules>
    </selectionEntry>
