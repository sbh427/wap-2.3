                  <characteristics>
                    <characteristic name="Special Rules" typeId="9d2e-d14d-dd58-a829">The Fiery Ring of Thori gives its bearer a Strength 4 Breath Weapon with the Flaming Attacks special rule.</characteristic>
                  </characteristics>
