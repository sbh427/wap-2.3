                      <profiles>
                        <profile name="Rune of Slowness (x3)" id="0a57-9532-a1b1-9aed" hidden="false" typeId="9fca-89e3-04a1-e4ae" typeName="Banner Rune">
                          <characteristics>
                            <characteristic name="Effect" typeId="51cc-aa7c-4178-d853">A third Rune of Slowness means a foe rolls 2D3 and must choose the highest dice when subtracting from his charge distance. Should a foe contact the bearing unit, they have Always Strikes Last in the first round of combat.</characteristic>
