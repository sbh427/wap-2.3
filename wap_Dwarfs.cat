                  <description>If Ungrim is the Army General, Troll Slayers are taken as Core units rather than Special units, and Giant Slayers are taken as Special units rather than Rare units.</description>
                </rule>
                <rule name="Brotherhood of Grimnir" id="5d94-d0be-bb14-e549" hidden="false">
                  <description>If Ungrim is included in your army, one unit of Troll Slayers or Giant Slayers may be upgraded to the Brotherhood of Grimnir for 1 point per model. These Slayers have the Wards of Grimnir special rule.</description>
                </rule>
              </rules>
