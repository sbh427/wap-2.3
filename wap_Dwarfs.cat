                      </modifiers>
                    </infoLink>
                  </infoLinks>
                  <profiles>
                    <profile name="Rune of Fate" id="12be-70cf-6156-eb41" hidden="false" typeId="46dc-ac3a-6194-9dc2" typeName="Talismanic Rune">
                      <characteristics>
                        <characteristic name="Effect" typeId="2019-7faf-64f7-0c61">One use only. The model has the Magical Ward (2+) special rule against the first unsaved Wound suffered.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Rune of Brotherhood" id="8ded-6191-ff0d-ede0" collective="false" hidden="false" import="true" sortIndex="4" type="upgrade">
                  <constraints>
                    <constraint id="049f-0c5b-7521-e21d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="5"/>
                  </costs>
                  <profiles>
                    <profile name="Rune of the Brotherhood" id="05e7-3538-f1e9-488d" hidden="false" typeId="46dc-ac3a-6194-9dc2" typeName="Talismanic Rune">
                      <characteristics>
                        <characteristic name="Effect" typeId="2019-7faf-64f7-0c61">May not be used by a character with an Oath stone or Shieldbearers. A character with this rune may either be deployed with a unit of Rangers utilising Scouts or join a unit of Miners utilising Ambushers. Multiples of this rune have no further effect.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
              <selectionEntryGroups>
