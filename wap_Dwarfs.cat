          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="f2b3-d6f7-270a-5dfd" field="selections" includeChildSelections="true" scope="model" shared="true" type="notInstanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Flakkson&apos;s Rune of Seeking" id="e070-7297-963f-1934" hidden="false" typeId="a099-45a8-556d-3912" typeName="Engineering Rune">
              <characteristics>
                <characteristic name="Effect" typeId="b5e6-a050-5ffa-0bb5">Bolt Throwers only. A war machine engraved with Flakkson&apos;s Rune of Seeking gains +1 To Hit against any Flying units. Multiples of this rune have no further effect.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Rune of Fortune" id="dcf1-acd8-e18e-6e06" collective="false" hidden="false" import="true" sortIndex="5" type="upgrade">
          <constraints>
            <constraint id="0418-c8ab-c32f-6a8a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
          </costs>
          <profiles>
            <profile name="Rune of Fortune" id="0e70-8f0b-f75a-6629" hidden="false" typeId="a099-45a8-556d-3912" typeName="Engineering Rune">
              <characteristics>
                <characteristic name="Effect" typeId="b5e6-a050-5ffa-0bb5">If a machine has the Rune of Fortune the player may re-roll the result on the machine&apos;s Misfire chart. Multiples of this rune have no further effect.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Enchanted Rune" id="cb8b-596d-5456-612e" collective="false" hidden="false" import="true" sortIndex="4" type="upgrade">
