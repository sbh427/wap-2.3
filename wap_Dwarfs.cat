    <selectionEntry name="Deathroller" id="6372-b5b3-c16c-0bd9" collective="false" hidden="false" import="true" sortIndex="23" type="model">
      <categoryLinks>
        <categoryLink name="Special" id="1503-728e-574d-b1fe" hidden="false" primary="true" targetId="fc26-7737-f7cb-8977"/>
        <categoryLink name="Chariot" id="bb71-3d76-8ca8-20b3" hidden="false" primary="false" targetId="7224-b7fd-d652-3ff2"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="80"/>
      </costs>
      <infoGroups>
        <infoGroup name="Boiler Incident Table" id="a2c0-48c2-a4cc-67c3" hidden="false">
          <profiles>
            <profile name="1" id="54ff-1639-66ce-b75c" hidden="false" typeId="be65-e0af-7bd1-11ca" typeName="Boiler Incident Table">
              <characteristics>
                <characteristic name="Result" typeId="27a6-de3a-b042-66d2">Remove the Deathroller as a casualty. All units in base contact with the Deathroller suffer D6 Strength 4 Hits with Armour Piercing (1).</characteristic>
              </characteristics>
            </profile>
            <profile name="02-04" id="6d61-92bc-0b5a-2651" hidden="false" typeId="be65-e0af-7bd1-11ca" typeName="Boiler Incident Table">
              <characteristics>
                <characteristic name="Result" typeId="27a6-de3a-b042-66d2">The Deathroller may not move this turn or use its Grinding Attack. If it breaks from combat this round, it is automatically destroyed.</characteristic>
              </characteristics>
            </profile>
            <profile name="05-06" id="53e2-42cd-3441-9645" hidden="false" typeId="be65-e0af-7bd1-11ca" typeName="Boiler Incident Table">
              <characteristics>
                <characteristic name="Result" typeId="27a6-de3a-b042-66d2">The Deathroller may only roll one D6 for each of its Movements this turn (including fleeing and pursuit).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </infoGroup>
      </infoGroups>
      <infoLinks>
        <infoLink name="Random Movement (*)" id="07a5-37fa-4b81-a496" hidden="false" targetId="16c3-c62d-b0ad-1a4c" type="rule">
