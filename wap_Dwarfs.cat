              <profiles>
                <profile name="Focal Lens of Morgrim" id="3a4f-94ec-9304-7102" hidden="false" typeId="ff67-d27f-2eef-bb35" typeName="Enchanted Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="9d2e-d14d-dd58-a829">The bearer and any unit they join gain +1 To Hit with missile weapons.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
