              <characteristics>
                <characteristic name="Effect" typeId="b5e6-a050-5ffa-0bb5">All shooting attacks from a war machine engraved with a Rune of Burning have Flaming Attacks. Multiples of this rune have no further effect.</characteristic>
              </characteristics>
            </profile>
