                      </costs>
                      <profiles>
                        <profile name="Rune of Slowness (x2)" id="4651-6428-8f1d-be73" hidden="false" typeId="9fca-89e3-04a1-e4ae" typeName="Banner Rune">
                          <characteristics>
                            <characteristic name="Effect" typeId="51cc-aa7c-4178-d853">A second Rune of Slowness means a foe rolls 2D3 and must choose the highest dice when subtracting from his charge distance.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Rune of Slowness (x3)" id="fb5d-fd58-bbdb-0a96" collective="false" hidden="false" import="true" type="upgrade">
