                <profile name="Rune of Doom" id="93db-cffd-8ea9-f71f" hidden="false" typeId="9dd3-c649-5416-b44f" typeName="Rune">
                  <characteristics>
                    <characteristic name="Details" typeId="ec93-9bb1-8e60-51a9">Until the start of the next friendly Magic phase, all friendly Dwarf units within 18&quot; gain the Fear special rule.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Master of Ancient Lore" id="d2f2-4a3c-3df4-f7cf" hidden="false">
                  <description>Thorek may roll an additional dice for his Leadership tests when attempting to Strike the Runes and discard the highest result.</description>
                </rule>
              </rules>
              <selectionEntries>
