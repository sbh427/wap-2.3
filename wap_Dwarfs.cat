          <modifierGroups>
            <modifierGroup type="and">
              <conditions>
                <condition childId="7397-9aeb-fd96-4051" field="selections" includeChildSelections="true" scope="parent" shared="true" type="lessThan" value="1"/>
              </conditions>
              <modifiers>
                <modifier arg="*" field="name" type="replace" value="2"/>
              </modifiers>
            </modifierGroup>
            <modifierGroup type="and">
              <conditions>
                <condition childId="7397-9aeb-fd96-4051" field="selections" includeChildSelections="true" scope="parent" shared="true" type="atLeast" value="1"/>
              </conditions>
              <modifiers>
                <modifier arg="*" field="name" type="replace" value="3"/>
