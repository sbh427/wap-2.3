                </profile>
                <profile name="Artillery Adjustment" id="ad60-9608-18f4-7849" hidden="false" typeId="0029-c268-b3eb-a723" typeName="Master of Accuracy rules">
                  <characteristics>
                    <characteristic name="Effect" typeId="7854-28b1-bbf5-4462">A war machine can use Grimm’s BS or re-roll one artillery dice. This can be the dice that determines the distance a cannonball bounces or a Flame Cannon’s burst of flame moves.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Increased Range" id="8a56-771a-112a-3dbc" hidden="false" typeId="0029-c268-b3eb-a723" typeName="Master of Accuracy rules">
                  <characteristics>
                    <characteristic name="Effect" typeId="7854-28b1-bbf5-4462">The unit’s Dwarf crossbows and Dwarf handguns increase their maximum range by 6&quot;.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Superior Volley" id="c05e-698c-252f-0df3" hidden="false" typeId="0029-c268-b3eb-a723" typeName="Master of Accuracy rules">
                  <characteristics>
                    <characteristic name="Effect" typeId="7854-28b1-bbf5-4462">Models in the unit get +1 to Hit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Master of Accuracy" id="b027-c293-f566-3e45" hidden="false">
                  <description>At the start of each friendly Shooting phase, Grimm can bestow one of the Master of Accuracy rules on a single friendly unit within 3&quot; for the duration of that Shooting phase, though he does not gain any bonuses for it himself.</description>
                </rule>
              </rules>
