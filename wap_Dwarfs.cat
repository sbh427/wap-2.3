    <infoGroup name="Rune Lore" id="c330-dbcf-ff35-0037" hidden="false">
      <infoLinks>
        <infoLink name="Rune of Wrath and Ruin" id="fc24-d0a4-cbfa-a8f5" hidden="false" targetId="8204-ac4d-f1bb-94c0" type="profile"/>
