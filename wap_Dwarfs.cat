                          <characteristics>
                            <characteristic name="Effect" typeId="daeb-8a2c-9eae-f2dd">This rune can only be placed on great weapons. It allows the great weapon to be enscribed with runes.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
