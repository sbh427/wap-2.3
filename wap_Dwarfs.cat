                      <profiles>
                        <profile name="Rune of Slowness (x1)" id="d1ef-873a-f2d1-cb25" hidden="false" typeId="9fca-89e3-04a1-e4ae" typeName="Banner Rune">
                          <characteristics>
                            <characteristic name="Effect" typeId="51cc-aa7c-4178-d853">Any foes charging a unit including a standard bearing a Rune of Slowness subtract D3&quot; from their charge distance (roll after their charge distance has been determined). If the enemy fails to make contact, all the rules for failed charges apply.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                    <selectionEntry name="Rune of Slowness (x2)" id="09b1-4b8e-44c6-f38b" collective="false" hidden="false" import="true" type="upgrade">
