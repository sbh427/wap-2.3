              </costs>
              <profiles>
                <profile name="Rune of Penetrating (x1)" id="1f64-7295-c454-99e9" hidden="false" typeId="a099-45a8-556d-3912" typeName="Engineering Rune">
                  <characteristics>
                    <characteristic name="Effect" typeId="b5e6-a050-5ffa-0bb5">A war machine engraved with a Rune of Penetration increases the Strength of its shots by +1. Note that in the case of a Grudge Thrower, this bonus increases the Strength of both Strength values in its profile.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
