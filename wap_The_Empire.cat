              <rules>
                <rule name="The Mad Count" id="09fa-0168-c188-0444" hidden="false">
                  <description>At the start of every friendly turn, Marius Leitdorf must take a Leadership test on 3D6, discarding the lowest result. If passed, he behaves himself and acts normally this turn, otherwise roll a D6 and consult the Mad Count Table.</description>
                </rule>
              </rules>
