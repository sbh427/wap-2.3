                  <characteristics>
                    <characteristic name="Special Rules" typeId="3df8-4ab0-c4bd-e2ad">Once per turn, the bearer of this item may attempt to cast the same spell twice. However, any time they roll a miscast, they suffer a +1 modifier to the result on the Miscast table.</characteristic>
                  </characteristics>
                </profile>
