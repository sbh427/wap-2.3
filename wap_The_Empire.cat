                      <profiles>
                        <profile name="The Talisman of Ulric" id="47ae-ff2c-f738-94c3" hidden="false" typeId="065f-58ea-de5d-d3c6" typeName="Talisman">
                          <characteristics>
                            <characteristic name="Special Rules" typeId="08ca-4a32-203d-40c0">At the start of every player turn, unless he has been removed as a casualty, Boris Todbringer instantly recovers any lost wounds, up to his starting total of 3. In addition, the Talisman is infused with the power and courage of Ulric, granting Boris Todbringer Magic Resistance (1) and gives him the Immunity (Psychology) special rule.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                  </selectionEntries>
