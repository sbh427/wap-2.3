        <characteristic name="Special Rules" typeId="de63-d6da-efa8-00ac">Armour Piercing (1). Requires Two Hands.</characteristic>
      </characteristics>
    </profile>
    <profile name="Runefang" id="244a-7466-2a15-b495" hidden="false" typeId="6f70-cea1-702c-43bc" typeName="Melee Weapon">
