        <rule name="Holy Fervour" id="8f31-072f-1da6-8e78" hidden="false">
          <description>All friendly Human units benefit from the rider&apos;s Righteous Fury special rule whilst within 6&quot; of the War Altar of Sigmar.</description>
        </rule>
        <rule name="The Power of Ulric" id="7001-24b2-eac9-c428" hidden="false">
          <description>Any Battle Prayers of Ulric cast by a model who is mounted on the War Altar of Ulric also target all friendly units within 6&quot;</description>
        </rule>
      </rules>
