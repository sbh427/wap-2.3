              <rules>
                <rule name="High Martriarch" id="b637-302e-6954-2d22" hidden="false">
                  <description>If Bertha Bestraufrung is included in your army, you must also include at least one unit of Sisters of Sigmar. Bertha Bestraufrung must join such a unit, and may not leave it. In addition, the unit becomes Stubborn while she remains with it.</description>
                </rule>
                <rule name="Sigmar&apos;s Handmaiden" id="dda8-4d71-67c5-4135" hidden="false">
                  <description>Bertha may re-roll failed Leadership tests when using Battle Prayers of Sigmar.</description>
                </rule>
              </rules>
