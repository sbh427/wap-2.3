              <profiles>
                <profile name="1 Fanatical Fury" id="a81b-fb43-5fb7-2d77" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
                  <characteristics>
                    <characteristic name="Result" typeId="686b-22d8-d67f-02eb">The unit re-rolls all failed rolls To Hit.</characteristic>
                  </characteristics>
                </profile>
                <profile name="2 Strength of the penitent" id="1bd1-d022-df5c-c87d" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
                  <characteristics>
                    <characteristic name="Result" typeId="686b-22d8-d67f-02eb">The unit re-rolls all failed rolls To Hit and To Wound.</characteristic>
                  </characteristics>
                </profile>
                <profile name="3 Insensible to Pain" id="8306-de75-bcf6-0aef" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
                  <characteristics>
                    <characteristic name="Result" typeId="686b-22d8-d67f-02eb">The unit gains +1 T, and re-rolls all failed rolls To Hit and To Wound.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </infoGroup>
