                <entryLink name="10. Character Options" id="b5bb-43fd-aaf6-25fe" hidden="false" import="true" targetId="35f1-2fc8-9817-3171" type="selectionEntryGroup"/>
              </entryLinks>
              <infoGroups>
                <infoGroup name="Mad Count Table" id="6ed0-302a-1d32-6d00" hidden="false">
                  <profiles>
                    <profile name="1 Lunatic Ravings" id="fcf5-0fac-a25e-4c76" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
                      <characteristics>
                        <characteristic name="Result" typeId="686b-22d8-d67f-02eb">Marius must immediately roll on the Stupidity special rule.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="2 Berserk Rage" id="1d18-3426-b9f9-6093" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
                      <characteristics>
                        <characteristic name="Result" typeId="686b-22d8-d67f-02eb">Marius has Frenzy, and cannot lose it, until he rolls on this table again.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="4 Tactical Brilliance" id="c9a4-e47e-44f9-87ad" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
                      <characteristics>
                        <characteristic name="Result" typeId="686b-22d8-d67f-02eb">Every friendly unit within 12&quot; of Marius may immediately make a Reform manoeuvre. These units can still move, charge, march and shoot as normal during this turn.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="3 Paranoid Delusions" id="c737-37fe-2b1d-0a1e" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
                      <characteristics>
                        <characteristic name="Result" typeId="686b-22d8-d67f-02eb">Marius immediately makes one close combat attack against a randomly chosen friendly model in base contact (if there are none, treat this result as Lunatic Ravings instead).</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="5 Outrageous Insult" id="1457-8adc-26cf-5bae" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
                      <characteristics>
                        <characteristic name="Result" typeId="686b-22d8-d67f-02eb">The closest enemy character to Marius has Hatred (Marius Leitdorf) for the rest of the game. This has no effect on units that have Immunity (Psychology).</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="6 Insane Bravado" id="dc2c-fd47-7fff-e18f" hidden="false" typeId="d549-1f73-1ba5-861c" typeName="Table / Chart">
                      <characteristics>
                        <characteristic name="Result" typeId="686b-22d8-d67f-02eb">Marius is treated as having rolled failed a Berserk Rage test (see Frenzy). In addition, he has the Stubborn special rule and must accept any challenge until he rolls on this table again.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </infoGroup>
              </infoGroups>
              <infoLinks>
                <infoLink name="Hold the Line!" id="950b-c851-8aec-fcb8" hidden="false" targetId="d409-4212-2849-023f" type="rule"/>
              </infoLinks>
              <modifiers>
                <modifier field="name" scope="root-entry" type="set" value="Marius Leitdorf"/>
              </modifiers>
              <profiles>
