                  <characteristics>
                    <characteristic name="Special Rules" typeId="3df8-4ab0-c4bd-e2ad">The Grey Wand gives the wielder a +D3 casting bonus. Roll for each spell casting attempt.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
