          <selectionEntries>
            <selectionEntry name="The Teutogen Guard" id="cbb7-39c7-d058-6038" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="3a9c-edb5-c193-1c05" field="selections" includeChildSelections="true" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <infoLinks>
