                  <description>The hawk may target models using the Sniper special rule. The target must pass a WS test or suffer a Strength 3 hit.</description>
                </rule>
                <rule name="Shrewd Tactician" id="0ba5-147a-02af-db03" hidden="false">
                  <description>After finishing deployment, D3 of your units within 12&quot; of Aldebrand Ludenhof may choose to redeploy to a new position up to 6&quot; away from their original position.</description>
                </rule>
              </rules>
