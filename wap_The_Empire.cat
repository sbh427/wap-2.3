      <rules>
        <rule name="Holy Fervour" id="bed3-4da9-0942-ec9d" hidden="false">
          <description>All friendly Human units benefit from the rider&apos;s Righteous Fury special rule whilst within 6&quot; of the War Altar of Sigmar.</description>
        </rule>
        <rule name="The Power of Sigmar" id="c103-8a4a-e4e5-5981" hidden="false">
          <description>Any Battle Prayers cast by a model who is mounted on the War Altar of Sigmar also target all friendly units within 6&quot;.</description>
        </rule>
      </rules>
