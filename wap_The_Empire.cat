                <profile name="Unbending Righteousness" id="e11c-09f4-fd76-3463" hidden="false" typeId="4608-9b35-b7dc-202d" typeName="Prayer">
                  <characteristics>
                    <characteristic name="Effect" typeId="1f79-8144-edd6-8b51">Luthor Huss and his unit gain the Stubborn special rule until the start of your next turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Chosen of Sigmar" id="2568-33f0-9a3d-4235" hidden="false">
                  <description>Luthor Huss has a Magical Ward (4+). In addition, once per game, he may harness the very power of Sigmar. Luthor must declare that he is harnessing this power at the start of any Close Combat phase. Roll a D3 – Luthor adds this number to his WS, S, T, and A characteristics until the end of the turn.</description>
                </rule>
              </rules>
            </selectionEntry>
