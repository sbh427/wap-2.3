              <rules>
                <rule name="The Swords of Ulric" id="d7a6-81cc-7a92-9301" hidden="false">
                  <description>If Boris Todbringer is included in your army, you may upgrade one unit of Swordsmen to the Swords of Ulric for +1 point per model. This unit gains the Frenzy special rule in the first round of close combat as well as the Crush the Weak and Hatred (Beastmen) special rules.</description>
                </rule>
              </rules>
