                  <characteristics>
                    <characteristic name="Effect" typeId="32f8-c3d9-bf18-d3c1">Enemy models in base contact with the Daemon at the start of any close combat phase suffer a Strength 3 Hit with the Flaming Attacks special rule. Any wounds caused count towards combat resolution.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
