      <selectionEntries>
        <selectionEntry name="Blazing Squealer (Pink Horror)" id="2cae-18a3-7f0d-cbee" hidden="false" import="true" sortIndex="1" type="model">
          <constraints>
            <constraint id="b8ff-5bfe-00e5-1de1" field="selections" scope="parent" shared="true" type="min" value="10"/>
