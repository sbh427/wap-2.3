    <profile name="6. Rancid Visitations" id="477a-9790-4c9d-b38b" hidden="false" noindex="true" typeId="cb92-d882-5ba8-11ab" typeName="Spell">
      <characteristics>
        <characteristic name="Spell Level" typeId="576b-eaa1-0bd1-3f7a">2</characteristic>
        <characteristic name="Type" typeId="21e9-4aa2-f538-c93b">Magic Missile</characteristic>
        <characteristic name="Casting Value" typeId="d6bf-647e-ba69-e8a0">10+</characteristic>
        <characteristic name="Range" typeId="2954-76ea-decb-30ff">18&quot;</characteristic>
        <characteristic name="Details" typeId="f5f2-ac1b-25cd-89c6">It inflicts D6 Strength 5 hits. The target unit must then immediately pass a Toughness test or suffer a further D6 hits. The target must keep taking Toughness tests until it passes, or is removed as a casualty.</characteristic>
      </characteristics>
    </profile>
