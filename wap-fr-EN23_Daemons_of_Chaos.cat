          <characteristics>
            <characteristic name="Effect" typeId="32f8-c3d9-bf18-d3c1">All friendly Daemons of Khorne units within 12&quot; of the Daemon may re-roll 1&apos;s To Wound and gain the Fight in Extra Ranks (1) special rule.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Slime Trail" id="d081-2a42-5322-de22" hidden="false" import="true" sortIndex="202" type="upgrade">
