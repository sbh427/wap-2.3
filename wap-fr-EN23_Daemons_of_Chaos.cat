                  <characteristics>
                    <characteristic name="Effect" typeId="32f8-c3d9-bf18-d3c1">Roll a D6 every time the Daemon suffers an unsaved Wound; on a 5+, the model that struck the blow suffers a Wound which Ignores Armour Saves.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
