              <rules>
                <rule name="Mesmerising Lepidoptera" id="019b-6544-91ad-df0c" hidden="false">
                  <description>All enemy attacks targeting Synessa suffer a -1 penalty To Hit.</description>
                </rule>
                <rule name="The Voice of Slaanesh" id="0fde-7c33-e309-1d3b" hidden="false">
                  <description>All friendly models within Line of Sight of Synessa may use their Leadership. In addition, any spells that Synessa casts can be targeted at any enemy unit within Line of Sight, regardless of range.</description>
                </rule>
              </rules>
