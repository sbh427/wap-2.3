                  <characteristics>
                    <characteristic name="Effect" typeId="32f8-c3d9-bf18-d3c1">The Daemon gains a +1 bonus when channelling Power dice.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Power Vortex" id="88a2-f12f-95ac-5ab9" hidden="false" import="true" sortIndex="10" type="upgrade">
              <constraints>
                <constraint id="673f-3bc0-c381-d8f3" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="30"/>
              </costs>
              <profiles>
                <profile name="Power Vortex" id="a2bf-0219-b04a-5d29" hidden="false" typeId="3e3c-de8a-94f0-179a" typeName="Daemonic Gift">
                  <characteristics>
                    <characteristic name="Effect" typeId="32f8-c3d9-bf18-d3c1">Once per Magic phase, the Daemon may add an additional &apos;free&apos; Power dice to the casting attempt. This can cause Ultimate Power as normal, and can cause the Daemon to roll more dice than normally allowed.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
