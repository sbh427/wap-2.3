              <rules>
                <rule name="Hounds of the Blood Hunt" id="7f05-eaba-e8c4-6cec" hidden="false">
                  <description>If Karanak is included in your army, you may upgrade one unit of Flesh Hounds to the Hounds of the Blood Hunt Host for a cost of +2 points per model. For every unsaved Wound caused by this unit in close combat, they regain 1 Wound&apos;s worth of models up to their starting value, just like a summoning spell.</description>
                </rule>
                <rule name="Karanak" id="eb83-65ab-a534-e9e0" hidden="false">
                  <description>Karanak may join units of Flesh Hounds.</description>
                </rule>
                <rule name="Prey of the Blood God" id="3d61-1492-6d83-94fb" hidden="false">
                  <description>At the start of the game, before deployment, nominate one character in the enemy army – this is the quarry of Khorne that Karanak has come to claim. Karanak re-rolls failed To Hit and To Wound rolls against the chosen character.</description>
                </rule>
              </rules>
            </selectionEntry>
