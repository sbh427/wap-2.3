              <rules>
                <rule name="The Hand of Destiny" id="5894-02e9-f3eb-b3aa" hidden="false">
                  <description>At the start of the game, choose one enemy model. All close combat and shooting attacks against this model will automatically Hit for the remainder of the game.</description>
                </rule>
                <rule name="Daemonic Aura" id="6357-2db7-8f7a-553a" hidden="false">
                  <description>Amon &apos;Chakai and all friendly units within 6&quot; gain +1 to their Ward saves (to a maximum of 3+) against non-Magical Attacks.</description>
                </rule>
              </rules>
