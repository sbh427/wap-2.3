                </infoLink>
              </infoLinks>
              <rules>
                <rule name="Phlegm Bombardment" id="d11e-21bf-146b-04f7" hidden="false">
                  <description>Phlegm Bombardment is a stone thrower with the mentioned profile. If a misfire is rolled on the artillery dice, the Soulgrinder suffers a wound with no saves allowed instead of rolling on the chart.</description>
                </rule>
              </rules>
            </selectionEntry>
