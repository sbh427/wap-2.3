                  <characteristics>
                    <characteristic name="Effect" typeId="32f8-c3d9-bf18-d3c1">Once per battle, at the start of any close combat phase, the Daemon can make the unit they are with subject to the Frenzy special rule for the remainder of this turn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Noxious Vapours" id="3893-a645-4c98-d78d" hidden="false" import="true" sortIndex="5" type="upgrade">
