                  <characteristics>
                    <characteristic name="Effect" typeId="32f8-c3d9-bf18-d3c1">If an enemy spell is successfully cast on a model with this Gift, or the unit it is in, roll a D6. On a 4+, the spell is destroyed after it has been resolved, and the enemy must discard the spell for the rest of the game.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
