                  <characteristics>
                    <characteristic name="Effect" typeId="32f8-c3d9-bf18-d3c1">The Daemon gains the Hatred special rule, which applies in all rounds of close combat. However, it must always pursue fleeing enemies.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
