      <profiles>
        <profile name="Nurgling Infestation" id="7153-dbbe-3907-be29" hidden="false" typeId="3e3c-de8a-94f0-179a" typeName="Daemonic Gift">
          <characteristics>
            <characteristic name="Effect" typeId="32f8-c3d9-bf18-d3c1">At the start of each of your turns, one unit of Nurglings within 6&quot; of the Daemon automatically regains D6 Wounds lost earlier in the battle.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
