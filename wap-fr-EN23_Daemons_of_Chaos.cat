          <description>All enemy Wizards within 18&quot; of an Infernal Enrapturess whose casting roll contains any double suffers a Strength 4 Hit for each double rolled.</description>
        </rule>
        <rule name="Harmonic Alignement" id="aab4-25e9-a540-9293" hidden="false">
          <description>All friendly Daemons of Slaanesh within 6&quot; of an Infernal Enrapturess may re-roll failed Ward saves.</description>
        </rule>
      </rules>
