              <profiles>
                <profile name="The Chromatic Tome" id="ea3b-3c59-aaa0-71ad" hidden="false" typeId="24d7-7f7d-a4d7-c26c" typeName="Arcane Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="3df8-4ab0-c4bd-e2ad">You can choose to re-roll the Winds of Magic dice in your turn. However, if you do so, your opponent can also re-roll the Winds of Magic dice in their next turn if they wish. In either case, all of the Winds of Magic dice must be re-rolled.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Nine-Eyed Tome" id="6afa-a46c-6463-7165" hidden="false" import="true" sortIndex="2" type="upgrade">
