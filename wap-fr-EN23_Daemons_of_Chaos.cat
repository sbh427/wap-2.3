              <profiles>
                <profile name="Spell Breaker" id="1803-60fd-4ef7-ae85" hidden="false" typeId="3e3c-de8a-94f0-179a" typeName="Daemonic Gift">
                  <characteristics>
                    <characteristic name="Effect" typeId="32f8-c3d9-bf18-d3c1">One use only. When an enemy spell has been cast, a Daemon with this Gift can use it instead of attempting to dispel the spell by using dispel dice. This gives them 6 free dice to attempt to dispel the spell, which cannot be combined with any other dispel dice. This may also be used to dispel spells that Remains in Play.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
