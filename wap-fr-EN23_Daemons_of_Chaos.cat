                  <characteristics>
                    <characteristic name="Effect" typeId="32f8-c3d9-bf18-d3c1">All enemy models in base contact with this Daemon are subject to the Always Strikes Last special rule in close combat. This has no effect on Daemons of Nurgle.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Nurgle&apos;s Rot" id="a351-8fee-0a58-04ec" hidden="false" import="true" sortIndex="6" type="upgrade">
