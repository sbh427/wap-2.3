                    <characteristic name="Details" typeId="f5f2-ac1b-25cd-89c6">It can target units of Plague Bearers, Nurglings or Plague Toads. The target unit immediately gains D6 Wounds worth of models.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
