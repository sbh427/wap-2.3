          <profiles>
            <profile name="Scions of the Dark Gods" id="8c3e-7cfd-8791-42df" hidden="false" typeId="cb92-d882-5ba8-11ab" typeName="Spell">
              <characteristics>
                <characteristic name="Spell Level" typeId="576b-eaa1-0bd1-3f7a">Lore Attribute</characteristic>
                <characteristic name="Type" typeId="21e9-4aa2-f538-c93b"/>
                <characteristic name="Casting Value" typeId="d6bf-647e-ba69-e8a0"/>
                <characteristic name="Range" typeId="2954-76ea-decb-30ff"/>
                <characteristic name="Details" typeId="f5f2-ac1b-25cd-89c6">Roll a D6 for each unsaved Wound caused by a spell from this lore; on a 5+, add 1 Wound&apos;s worth of models to one friendly Daemonic unit within 12&quot; of the caster, just like a summoning spell.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="The Summoning" id="eb81-3408-e486-63f8" hidden="false" import="true" type="upgrade">
