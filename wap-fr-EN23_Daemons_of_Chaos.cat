              <profiles>
                <profile name="Wand of Whimsy" id="daa5-cb3c-d3ae-c31b" hidden="false" typeId="24d7-7f7d-a4d7-c26c" typeName="Arcane Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="3df8-4ab0-c4bd-e2ad">Whenever the bearer successfully casts or dispels a spell, roll a D6 – the Wand of Whimsy gains a charge token on a roll of 5+. The Wand of Whimsy grants the bearer a bonus to both Strength and Attacks equal to the number of charge tokens for the remainder of the game.</characteristic>
