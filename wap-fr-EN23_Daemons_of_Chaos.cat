                  <characteristics>
                    <characteristic name="Effect" typeId="32f8-c3d9-bf18-d3c1">This is a Strength 4 Breath Weapon. It has no effect on Daemons of Nurgle.</characteristic>
                  </characteristics>
                </profile>
