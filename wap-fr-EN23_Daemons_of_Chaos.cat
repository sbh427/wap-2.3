      </entryLinks>
      <profiles>
        <profile name="Master of Sorcery" id="fd62-6f2b-9935-d9ea" hidden="false" typeId="3e3c-de8a-94f0-179a" typeName="Daemonic Gift">
          <characteristics>
            <characteristic name="Effect" typeId="32f8-c3d9-bf18-d3c1">The Daemon gains the Loremaster special rule. In addition, it can use any of the Winds of Magic from the Warhammer Rulebook instead of its normal Lore.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="All-Seeing Eye" id="3709-20df-82f5-4f24" hidden="false" import="true" sortIndex="213" type="upgrade">
      <constraints>
        <constraint id="45af-5da5-6a23-78e5" field="selections" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <profiles>
        <profile name="All-Seeing Eye" id="882b-9206-88f1-451d" hidden="false" typeId="3e3c-de8a-94f0-179a" typeName="Daemonic Gift">
          <characteristics>
            <characteristic name="Effect" typeId="32f8-c3d9-bf18-d3c1">At the start of each of your Magic Phases, you may pick one enemy unit within 24&quot; of the Daemon. That unit must reveal all Magic Items and Hidden units in it.</characteristic>
          </characteristics>
        </profile>
      </profiles>
