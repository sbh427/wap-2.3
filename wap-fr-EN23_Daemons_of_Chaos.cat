              <rules>
                <rule name="Mesmerising Lepidoptera" id="a3ef-cee9-1b89-8e25" hidden="false">
                  <description>All enemy attacks targeting Dexcessa suffer a -1 penalty To Hit.</description>
                </rule>
                <rule name="Joyous Battle Fury" id="eaaa-04d5-2d56-b91f" hidden="false">
                  <description>Dexcessa receive +1 Attack for each round of close combat after the first, for as a long as they remain in close combat (to a maximum of 10 Attacks total).</description>
                </rule>
                <rule name="Redolence of Violence" id="9c09-f9e9-d85b-2851" hidden="false">
                  <description>During any turn in which Dexcessa makes a successful charge, all friendly Daemon of Slaanesh units within 12&quot; gain +1 Attack for the duration of this turn.</description>
                </rule>
              </rules>
