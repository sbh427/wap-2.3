                </profile>
              </profiles>
              <rules>
                <rule name="Cultivating the Garden of Nurgle" id="b667-8ef7-1f52-6b10" hidden="false">
                  <description>Once during the battle, at the start of your turns, you can set up a Venom Thicket (see the Warhammer Rulebook) within 3&quot; of Horticulous Slimux and more than 1&quot; away from any other model or terrain feature.</description>
                </rule>
                <rule name="Beast Handler" id="08d1-1b27-d804-2be3" hidden="false">
                  <description>Friendly Beasts of Nurgle within 12&quot; of Horticulous Slimux re-roll failed charge rolls and To Hit rolls of 1.</description>
                </rule>
                <rule name="In Death there is Life" id="739d-77b2-1bc9-3ab2" hidden="false">
                  <description>All friendly units within 6&quot; of Horticulous Slimux gain the Regeneration (6+) special rule.</description>
                </rule>
              </rules>
