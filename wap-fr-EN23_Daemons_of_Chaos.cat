              <rules>
                <rule name="Oracle of Eternity" id="9dd9-0532-56d3-d60f" hidden="false">
                  <description>Kairos Fateweaver has a 6+ Ward save.</description>
                </rule>
                <rule name="The Blazing Squealers" id="b455-5907-a4a7-5002" hidden="false">
                  <description>If Kairos Fateweaver is included in your army, you may upgrade one unit of Pink Horrors to the Blazing Squealers for a cost of +2 points per model. The Lesser Flames of Tzeentch from this unit are resolved at Strength 4 instead of Strength 3.</description>
                </rule>
