              <profiles>
                <profile name="Nine-Eyed Tome" id="19e9-518b-e1e9-1b69" hidden="false" typeId="24d7-7f7d-a4d7-c26c" typeName="Arcane Item">
                  <characteristics>
                    <characteristic name="Special Rules" typeId="3df8-4ab0-c4bd-e2ad">The bearer can re-roll one casting or dispel attempt each Magic phase.</characteristic>
                  </characteristics>
