                  <characteristics>
                    <characteristic name="Effect" typeId="32f8-c3d9-bf18-d3c1">Enemy models in base contact with the Daemon at the start of any close combat phase suffer a Strength 2 Hit with the Ignores Armour Saves special rule. This has no effect on Daemons of Nurgle.</characteristic>
                  </characteristics>
                </profile>
