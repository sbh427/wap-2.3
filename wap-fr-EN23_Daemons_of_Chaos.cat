              </profiles>
              <rules>
                <rule name="Call of the Skull Throne" id="c529-4cf6-590f-fc94" hidden="false">
                  <description>All friendly Daemons of Khorne within 12&quot; of Skaarac may re-roll failed charge distances.</description>
                </rule>
                <rule name="Life Eater" id="178a-08df-82f8-70f1" hidden="false">
                  <description>Roll a D6 for each Wound inflicted by Skaarac in close combat. For each result of a 6, he may restore one Wound previously lost during the battle.</description>
                </rule>
                <rule name="Infernal Iron" id="22d5-a8a4-05ce-9b17" hidden="false">
                  <description>All Wizards within 12&quot; of Skaarac suffer a -1 casting penalty.</description>
                </rule>
                <rule name="Undying Hate" id="5705-a247-a552-fe7a" hidden="false">
                  <description>If this model is slain, before removing it, all models in base contact suffers a Strength 5 Hit which Ignores Armour saves.</description>
                </rule>
              </rules>
