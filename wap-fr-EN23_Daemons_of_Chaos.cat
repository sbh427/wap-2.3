                  <characteristics>
                    <characteristic name="Effect" typeId="32f8-c3d9-bf18-d3c1">This is a Breath Weapon. Each model hit suffers a Wound on a 5+ which Ignores Armour saves. It has no effect on Daemons of Nurgle.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Pestilent Breath" id="b1dc-67d2-d251-7711" hidden="false" typeId="5ac6-af7f-fe0f-57cd" typeName="Ranged Weapon">
                  <characteristics>
                    <characteristic name="Range" typeId="af3c-d805-702c-9af9">Breath Weapon</characteristic>
