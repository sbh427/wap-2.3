              <rules>
                <rule name="Streams of Brackish Filth" id="08b5-f74f-bab7-3d7a" hidden="false">
                  <description>At the start of each of your Shooting phases, all enemy units within 6&quot; of Rotigus suffer D3 Strength 4 Hits.</description>
                </rule>
                <rule name="Blubber and Bile" id="8645-ac2d-1bf3-7465" hidden="false">
                  <description>Each time Rotigus successfully makes a Regeneration save in close combat, he inflicts a Strength 4 Hit on the model which caused the Wound.</description>
                </rule>
              </rules>
