          <characteristics>
            <characteristic name="Effect" typeId="32f8-c3d9-bf18-d3c1">Enemy units do not receive combat resolution bonuses for attacking the flank or rear of a Daemon with this ability, or any unit he has joined.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Nurgling Infestation" id="77b2-b295-9d96-cfbc" hidden="false" import="true" sortIndex="203" type="upgrade">
