                <cost name="pts" typeId="points" value="35"/>
              </costs>
              <profiles>
                <profile name="Lord of Flux" id="be7f-e054-9a74-e2c3" hidden="false" typeId="3e3c-de8a-94f0-179a" typeName="Daemonic Gift">
                  <characteristics>
                    <characteristic name="Effect" typeId="32f8-c3d9-bf18-d3c1">At the beginning of each round of close combat, all enemy models in base contact with the Daemon must roll a D6, on a 4+ they suffer 1 Wound which Ignores Armour Saves.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Aspect of Tzeentch" id="6565-f461-9ed0-a8a8" hidden="false" import="true" sortIndex="12" type="upgrade">
              <constraints>
                <constraint id="f2ce-10ef-ebd7-e993" field="selections" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="40"/>
